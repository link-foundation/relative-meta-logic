    {"name":"ordered rule choice", "program":"rules", "input":["choose","a"], "output":["selected","first","a"]},
    {"name":"nested left traversal", "program":"rules", "input":["outer",["choose","a"],["choose","b"]], "output":["outer",["selected","first","a"],["selected","first","b"]]},
    {"name":"recursive substitution", "program":"rules", "input":["input","value"], "output":["pair",["nested","value"],"done"]},
    {"name":"import rebinding", "program":"imported", "input":["renamed","value"], "output":["pair",["nested","value"],"done"]}
  ],
  "program":"proof",
