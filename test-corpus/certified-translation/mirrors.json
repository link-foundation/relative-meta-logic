{
  "schema": "rml:certified-bulk-mirrors:1",
  "purpose": "Admitted bulk translations that have a hand-written mirror in the other runtime. Each expected line is the mirror's documented behaviour, derived by reading the mirror source cited here; no mirror is compiled or executed locally.",
  "mirrors": [
    {
      "id": "quantize",
      "from": "JavaScript", "to": "Rust",
      "source": { "path": "js/src/rml-links.mjs", "name": "quantize" },
      "mirror": { "path": "rust/src/lib.rs", "name": "quantize", "signature": "pub fn quantize(x: f64, valence: u32, lo: f64, hi: f64) -> f64 {" },
      "correspondence": "domain-widened",
      "note": "The certified signature takes valence as f64; the mirror takes u32, so calls stay at non-negative integral valences. Rust f64::round rounds a tie away from zero and JavaScript Math.round towards +Infinity; the clamp to level 0 absorbs the only tie where they differ (-0.5).",
      "calls": [
        { "args": "0.37, 3, 0, 1", "expected": "0.5", "because": "step 0.5, round(0.74) = 1, 0 + 1 * 0.5" },
        { "args": "0.25, 3, 0, 1", "expected": "0.5", "because": "step 0.5, round(0.5) = 1 (tie away from zero)" },
        { "args": "0.125, 5, 0, 1", "expected": "0.25", "because": "step 0.25, round(0.5) = 1" },
        { "args": "-0.125, 5, 0, 1", "expected": "0", "because": "round(-0.5) = -1, clamped by max(0.0) to 0, 0 + 0 * 0.25" },
        { "args": "-2, 5, 0, 1", "expected": "0", "because": "round(-8) = -8, clamped to 0" },
        { "args": "0.9, 2, 0, 1", "expected": "1", "because": "step 1, round(0.9) = 1, Display prints 1.0f64 as 1" },
        { "args": "7, 1, 0, 1", "expected": "7", "because": "valence < 2 returns x unchanged" }
      ]
    },
    {
      "id": "is-strictly-offending-status",
      "from": "JavaScript", "to": "Rust",
      "source": { "path": "js/src/rml-links.mjs", "name": "_isStrictlyOffendingStatus" },
      "mirror": { "path": "rust/src/lib.rs", "name": "is_strictly_offending_status", "signature": "fn is_strictly_offending_status(status: Option<&String>) -> bool {" },
      "correspondence": "domain-widened",
      "note": "The mirror also accepts None (false); the certified signature takes a String, which corresponds to the mirror's Some(s) arm.",
      "calls": [
        { "args": "'host-primitive'", "expected": "true", "because": "Some(s) with s == \"host-primitive\"" },
        { "args": "'host-derived'", "expected": "true", "because": "Some(s) with s == \"host-derived\"" },
        { "args": "'kernel'", "expected": "false", "because": "Some(s) with any other text" }
      ]
    },
    {
      "id": "prefix-marker",
      "from": "JavaScript", "to": "Rust",
      "source": { "path": "js/src/check.mjs", "name": "prefixMarker" },
      "mirror": { "path": "rust/src/check.rs", "name": "prefix_marker", "signature": "fn prefix_marker(name: &str) -> &'static str {" },
      "correspondence": "same-domain",
      "calls": [
        { "args": "'not'", "expected": "not", "because": "match arm \"not\"" },
        { "args": "'+'", "expected": "sum", "because": "match arm \"+\"" },
        { "args": "'-'", "expected": "difference", "because": "match arm \"-\"" },
        { "args": "'*'", "expected": "product", "because": "match arm \"*\"" },
        { "args": "'/'", "expected": "quotient", "because": "match arm \"/\"" },
        { "args": "'max'", "expected": "reduce", "because": "the wildcard arm" }
      ]
    },
    {
      "id": "is-lean-punct-char",
      "from": "JavaScript", "to": "Rust",
      "source": { "path": "js/src/cst-lean.mjs", "name": "isLeanPunctChar" },
      "mirror": { "path": "rust/src/cst_lean.rs", "name": "is_lean_punct_char", "signature": "fn is_lean_punct_char(c: char) -> bool {" },
      "correspondence": "domain-widened",
      "note": "The certified signature takes a String; the mirror's char corresponds to one-scalar strings, the only ones the lexers pass. On the empty string the JavaScript includes() is true, which no char can reach.",
      "calls": [
        { "args": "'→'", "expected": "true", "because": "listed in the matches! set" },
        { "args": "'«'", "expected": "true", "because": "listed in the matches! set" },
        { "args": "'∀'", "expected": "false", "because": "not in the Lean set" },
        { "args": "'a'", "expected": "false", "because": "not in the Lean set" }
      ]
    },
    {
      "id": "is-rocq-punct-char",
      "from": "JavaScript", "to": "Rust",
      "source": { "path": "js/src/cst-rocq.mjs", "name": "isRocqPunctChar" },
      "mirror": { "path": "rust/src/cst_rocq.rs", "name": "is_rocq_punct_char", "signature": "fn is_rocq_punct_char(c: char) -> bool {" },
      "correspondence": "domain-widened",
      "note": "As for is_lean_punct_char: one-scalar strings correspond to char.",
      "calls": [
        { "args": "'∀'", "expected": "true", "because": "listed in the matches! set" },
        { "args": "'¬'", "expected": "true", "because": "listed in the matches! set" },
        { "args": "'↦'", "expected": "false", "because": "a Lean, not a Rocq, operator" },
        { "args": "'('", "expected": "false", "because": "not in the Rocq set" }
      ]
    },
    {
      "id": "scan-lean-block-comment",
      "from": "JavaScript", "to": "Rust",
      "source": { "path": "js/src/cst-lean.mjs", "name": "scanBlockComment" },
      "mirror": { "path": "rust/src/cst_lean.rs", "name": "scan_block_comment", "signature": "fn scan_block_comment(chars: &[char], i: usize) -> usize {" },
      "correspondence": "domain-widened",
      "note": "The certified signature types src as an array of one-scalar strings, matching the mirror's &[char]; the index is f64 where the mirror uses usize.",
      "calls": [
        { "args": "['/', '-', ' ', '-', '/', 'x'], 0", "expected": "5", "because": "j = 2; ' ' advances to 3; \"-/\" closes depth 1 at j = 5" },
        { "args": "['/', '-', '/', '-', '-', '/', '-', '/', 'x'], 0", "expected": "8", "because": "\"/-\" opens depth 2 at j = 4, \"-/\" to depth 1 at 6, \"-/\" to depth 0 at 8" },
        { "args": "['/', '-', '-'], 0", "expected": "3", "because": "chars.get(3) is None, so '-' only advances j to 3 = len" },
        { "args": "['x', '/', '-', 'a'], 1", "expected": "4", "because": "unterminated: j runs from 3 to len" }
      ]
    },
    {
      "id": "scan-rocq-block-comment",
      "from": "JavaScript", "to": "Rust",
      "source": { "path": "js/src/cst-rocq.mjs", "name": "scanBlockComment" },
      "mirror": { "path": "rust/src/cst_rocq.rs", "name": "scan_block_comment", "signature": "fn scan_block_comment(chars: &[char], i: usize) -> usize {" },
      "correspondence": "domain-widened",
      "note": "As for the Lean scanner, with (* and *) delimiters.",
      "calls": [
        { "args": "['(', '*', 'a', '*', ')', 'b'], 0", "expected": "5", "because": "\"*)\" at j = 3 closes depth 1 at 5" },
        { "args": "['(', '*', '(', '*', '*', ')', '*', ')'], 0", "expected": "8", "because": "nested comment closes at the end" },
        { "args": "['(', '*', '*'], 0", "expected": "3", "because": "chars.get(3) is None" }
      ]
    },
    {
      "id": "scan-rust-block-comment",
      "from": "JavaScript", "to": "Rust",
      "source": { "path": "js/src/cst-rust.mjs", "name": "scanBlockComment" },
      "mirror": { "path": "rust/src/cst_rust.rs", "name": "scan_block_comment", "signature": "fn scan_block_comment(chars: &[char], i: usize) -> usize {" },
      "correspondence": "domain-widened",
      "note": "As for the Lean scanner, with /* and */ delimiters.",
      "calls": [
        { "args": "['/', '*', 'a', '*', '/', 'b'], 0", "expected": "5", "because": "\"*/\" at j = 3 closes depth 1 at 5" },
        { "args": "['/', '*', '/', '*', '*', '/', '*', '/'], 0", "expected": "8", "because": "nested comment closes at the end" }
      ]
    },
    {
      "id": "range-within",
      "from": "JavaScript", "to": "Rust",
      "source": { "path": "js/src/rml-formal-corpus.mjs", "name": "rangeWithin" },
      "mirror": { "path": "rust/src/formal_corpus.rs", "name": "range_within", "signature": "fn range_within(inner: [usize; 2], outer: [usize; 2]) -> bool {" },
      "correspondence": "domain-widened",
      "note": "The certified signature takes Vec<f64>; the mirror's [usize; 2] corresponds to two-element non-negative integral arrays.",
      "calls": [
        { "args": "[1, 2], [0, 3]", "expected": "true", "because": "1 >= 0 and 2 <= 3" },
        { "args": "[0, 4], [1, 3]", "expected": "false", "because": "0 < 1" },
        { "args": "[1, 3], [1, 3]", "expected": "true", "because": "both bounds equal" }
      ]
    },
    {
      "id": "is-variable",
      "from": "JavaScript", "to": "Rust",
      "source": { "path": "js/src/rml-foundation-workspace.mjs", "name": "isVariable" },
      "mirror": { "path": "rust/src/foundation_workspace.rs", "name": "is_variable", "signature": "fn is_variable(term: &Node) -> bool {" },
      "correspondence": "domain-widened",
      "note": "The certified signature takes a String, corresponding to the mirror's Node::Leaf arm. The mirror measures UTF-8 bytes and the source UTF-16 units, but both exceed 1 exactly when a character follows the leading '?'.",
      "calls": [
        { "args": "'?x'", "expected": "true", "because": "Leaf(\"?x\"): len 2 > 1 and starts with '?'" },
        { "args": "'?'", "expected": "false", "because": "len 1" },
        { "args": "'x?'", "expected": "false", "because": "does not start with '?'" },
        { "args": "'?é'", "expected": "true", "because": "UTF-8 len 3 > 1" }
      ]
    },
    {
      "id": "is-pi-sig",
      "from": "JavaScript", "to": "Rust",
      "source": { "path": "js/src/rml-links.mjs", "name": "_isPiSig" },
      "mirror": { "path": "rust/src/lib.rs", "name": "is_pi_sig", "signature": "fn is_pi_sig(node: &Node) -> bool {" },
      "correspondence": "domain-widened",
      "note": "The certified signature takes Vec<String>, corresponding to a Node::List of leaves.",
      "calls": [
        { "args": "['Pi', 'A', 'B']", "expected": "true", "because": "List of 3 with head Leaf(\"Pi\")" },
        { "args": "['Pi', 'A']", "expected": "false", "because": "List of 2" },
        { "args": "['Sigma', 'A', 'B']", "expected": "false", "because": "head is not \"Pi\"" }
      ]
    },
    {
      "id": "is-forall-node",
      "from": "JavaScript", "to": "Rust",
      "source": { "path": "js/src/rml-links.mjs", "name": "_isForallNode" },
      "mirror": { "path": "rust/src/lib.rs", "name": "is_forall_node", "signature": "fn is_forall_node(node: &Node) -> bool {" },
      "correspondence": "domain-widened",
      "note": "The certified signature takes Vec<String>, so children[1] is always a leaf, as the mirror requires.",
      "calls": [
        { "args": "['forall', 'x', 'P']", "expected": "true", "because": "List of 3, head \"forall\", second a leaf" },
        { "args": "['forall', 'x']", "expected": "false", "because": "List of 2" },
        { "args": "['exists', 'x', 'P']", "expected": "false", "because": "head is not \"forall\"" }
      ]
    },
    {
      "id": "token-base-name",
      "from": "JavaScript", "to": "Rust",
      "source": { "path": "js/src/rml-links.mjs", "name": "tokenBaseName" },
      "mirror": { "path": "rust/src/lib.rs", "name": "token_base_name", "signature": "fn token_base_name(token: &str) -> String {" },
      "correspondence": "signature-differs",
      "note": "Without a call site or JSDoc the certified translation infers token: Option<f64>, so typeof token is never \"string\" and the Rust target returns None for every input; the mirror is the identity on &str. The bulk translation is certified for its inferred type, not for the mirror's domain, so no behaviour is compared.",
      "calls": []
    },
    {
      "id": "rule-key",
      "from": "JavaScript", "to": "Rust",
      "source": { "path": "js/src/rml-foundation-workspace.mjs", "name": "ruleKey" },
      "mirror": { "path": "rust/src/foundation_workspace.rs", "name": "rule_key", "signature": "fn rule_key(kind: &str, program: &str, rule: &str) -> String {" },
      "correspondence": "signature-differs",
      "note": "Without a call site or JSDoc the certified translation infers kind, program and rule as f64; the mirror takes &str. No behaviour is compared on this path; the reverse path below compares it.",
      "calls": []
    },
    {
      "id": "rule-key-reverse",
      "from": "Rust", "to": "JavaScript",
      "source": { "path": "rust/src/foundation_workspace.rs", "name": "rule_key" },
      "mirror": { "path": "js/src/rml-foundation-workspace.mjs", "name": "ruleKey", "signature": "function ruleKey(kind, program, rule) {" },
      "correspondence": "same-domain",
      "note": "Rust to JavaScript: the certified JavaScript target itself runs in Node. The JavaScript mirror joins with NUL characters in a template literal.",
      "calls": [
        { "args": "\"proof\", \"main\", \"r1\"", "expected": "proof\u0000main\u0000r1", "because": "`${kind}\\0${program}\\0${rule}`" },
        { "args": "\"\", \"\", \"\"", "expected": "\u0000\u0000", "because": "empty parts keep both separators" }
      ]
    },
    {
      "id": "token-base-name-reverse",
      "from": "Rust", "to": "JavaScript",
      "source": { "path": "rust/src/lib.rs", "name": "token_base_name" },
      "mirror": { "path": "js/src/rml-links.mjs", "name": "tokenBaseName", "signature": "function tokenBaseName(token) {" },
      "correspondence": "domain-widened",
      "note": "The JavaScript mirror also maps non-strings to null; the certified source takes &str, which corresponds to its string branch.",
      "calls": [
        { "args": "\"x_1\"", "expected": "x_1", "because": "a string token is returned unchanged" },
        { "args": "\"\"", "expected": "", "because": "the empty string is a string" }
      ]
    }
  ]
}
