  (assumptions (count 0))
  (encodings
    (count 4)
    (encoding arrays "a JavaScript array, which the portable core never mutates, is a Rocq list; a read walks it to the index")
    (encoding floats "a JavaScript Number is a Rocq primitive float, the same IEEE-754 binary64 with the same arithmetic, which the kernel computes with; % is ml_float_rem, the exact truncated remainder, and ml_js_number prints a value as JavaScript does")
    (encoding general-recursion "recursion without a termination argument Rocq could check is ml_fix over the function's one-step unfolding, which unfolds lazily to 2^64 nested calls: every run that terminates computes the same value, and Rocq accepts it as a plain Definition")
    (encoding program-output "main is the list of lines the source program prints, in order; evaluating it with vm_compute runs the program"))
  (observation
    (status completed)
    (lines-sha256 e3b0c44298fc1c149afbf4c8996fb92427ae41e4649b934ca495991b7852b855))
  (obligations
    (obligation
      (id emitter-faithfulness)
      (kind trust)
      (source intermediate)
      (target Rocq)
      (closed false)
      (status open)
      (by native-oracle-ci)))
  (verdict (discharged 0) (open 1) (assumed 0) (refuted 0))
