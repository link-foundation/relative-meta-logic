    (encoding arrays "a JavaScript array, which the portable core never mutates, is a Lean Array; a read outside it panics")
    (encoding floats "a JavaScript Number is a Lean Float, the same IEEE-754 binary64 with the same arithmetic; % is ml_float_rem, the exact truncated remainder, and ml_js_number prints a value as JavaScript does")
