(linked-program frame-rules)
(linked-inference frame-rules atom-forced
  (premise (valuation-holds ?w ?p))
  (conclusion (forces-at ?w ?p)))
(linked-inference frame-rules dia-intro
  (premise (modal-atom ?phi))
  (premise (acc-arrow ?u ?v))
  (premise (forces-at ?v ?phi))
  (conclusion (forces-at ?u (pos-dia ?phi))))
(linked-inference frame-rules box-elim
  (premise (forces-at ?u (nec-box ?phi)))
  (premise (acc-arrow ?u ?v))
  (conclusion (forces-at ?v ?phi)))
(linked-inference frame-rules dead-end-blocks
  (premise (dead-end ?w))
  (premise (modal-atom ?phi))
  (conclusion (blocks-at ?w (pos-dia ?phi))))
(linked-inference frame-rules path-step
  (premise (forces-at ?w ?phi))
  (premise (acc-arrow ?w ?v))
  (premise (forces-at ?v (along-path ?phi)))
  (conclusion (forces-at ?w (along-path ?phi))))
(linked-program modal-negation)
(linked-rewrite modal-negation forced-opposite
  (from (refutation-of (forces-at ?w ?phi)))
  (to (blocks-at ?w ?phi)))
(linked-program modal-abbreviations)
(linked-rewrite modal-abbreviations strict-arrow-unfolds
  (from (strict-arrow ?a ?b))
  (to (nec-box (alt-or (alt-not ?a) ?b))))
(linked-rewrite modal-abbreviations mirror-pair-swaps
  (from (mirror-pair ?a ?b))
  (to (mirror-pair ?b ?a)))
(linked-program lab-frame)
(linked-fact lab-frame home-sees-lab (judgement (acc-arrow w-home w-lab)))
(linked-fact lab-frame lab-sees-field (judgement (acc-arrow w-lab w-field)))
(linked-fact lab-frame orbit-sees-orbit (judgement (acc-arrow w-orbit w-orbit)))
(linked-fact lab-frame field-is-dry (judgement (valuation-holds w-field sample-dry)))
(linked-fact lab-frame orbit-is-dry (judgement (valuation-holds w-orbit sample-dry)))
(linked-fact lab-frame home-boxes-wet (judgement (forces-at w-home (nec-box sample-wet))))
(linked-fact lab-frame field-ends (judgement (dead-end w-field)))
(linked-fact lab-frame ghost-ends (judgement (dead-end w-ghost)))
(linked-fact lab-frame ghost-sees-orbit (judgement (acc-arrow w-ghost w-orbit)))
(linked-fact lab-frame dry-is-atomic (judgement (modal-atom sample-dry)))
(linked-fact lab-frame wet-is-atomic (judgement (modal-atom sample-wet)))
(linked-foundation modal-frames (version 1)
  (inference frame-rules)
  (proof modal-negation)
  (reduction modal-abbreviations)
  (signature
    (forces-at ?w ?phi) (blocks-at ?w ?phi) (acc-arrow ?u ?v)
    (valuation-holds ?w ?p) (dead-end ?w) (modal-atom ?p))
  (cycle-policy inductive))
(linked-instance study-lab (theory lab-frame) (foundation modal-frames (version 1)))
