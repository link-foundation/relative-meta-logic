{
  "schema": "rml:binding-rewrite-tests:1",
  "contract": "checked rml:structure:1 identities; accepted only when fresh resolution keeps every occurrence's status and targets; exact layout outside renamed tokens is unchanged",
  "cases": [
    {"name":"lambda binder and body","source":"(lambda (Natural x) (+ x 1))\n","site":"0.1.1","to":"y","expected":"(lambda (Natural y) (+ y 1))\n","canonical":"(lambda (Natural y) (+ y 1))\n","edits":[{"address":"0.1.1","from":"x","to":"y","line":1,"col":18},{"address":"0.2.1","from":"x","to":"y","line":1,"col":24}]},
    {"name":"outer binder keeps the shadowing inner binder","source":"(lambda (Natural x) (lambda (Natural x) x))\n","site":"0.1.1","to":"y","expected":"(lambda (Natural y) (lambda (Natural x) x))\n","canonical":"(lambda (Natural y) (lambda (Natural x) x))\n","edits":[{"address":"0.1.1","from":"x","to":"y","line":1,"col":18}]},
    {"name":"inner binder captures the renamed outer reference","source":"(lambda (Natural x) (lambda (Natural y) x))\n","site":"0.1.1","to":"y","error":"RML_RENAME_CAPTURE"},
    {"name":"free reference would be captured","source":"(lambda (Natural x) (+ x y))\n","site":"0.1.1","to":"y","error":"RML_RENAME_CAPTURE"},
    {"name":"comments are layout while quoted spellings are the same reference","source":"# x is mentioned here\n(lambda (Natural x) (x \"x\")) # x\n","site":"0.1.1","to":"y","expected":"# x is mentioned here\n(lambda (Natural y) (y y)) # x\n","canonical":"(lambda (Natural y) (y y))\n","edits":[{"address":"0.1.1","from":"x","to":"y","line":2,"col":18},{"address":"0.2.0","from":"x","to":"y","line":2,"col":22},{"address":"0.2.1","from":"x","to":"y","line":2,"col":24}]},
    {"name":"Unicode binder with code-point locations","source":"(lambda (Natural α) (+ α 𝒙))\n(lambda (Natural 𝒙) (+ 𝒙 α))\n","site":"1.1.1","to":"𝒚","expected":"(lambda (Natural α) (+ α 𝒙))\n(lambda (Natural 𝒚) (+ 𝒚 α))\n","canonical":"(lambda (Natural α) (+ α 𝒙))\n(lambda (Natural 𝒚) (+ 𝒚 α))\n","edits":[{"address":"1.1.1","from":"𝒙","to":"𝒚","line":2,"col":18},{"address":"1.2.1","from":"𝒙","to":"𝒚","line":2,"col":24}]},
    {"name":"BOM and CRLF keep their bytes","source":"﻿(lambda (Natural x)\r\n  (+ x 1))\r\n","site":"0.1.1","to":"z","expected":"﻿(lambda (Natural z)\r\n  (+ z 1))\r\n","canonical":"(lambda (Natural z) (+ z 1))\n","edits":[{"address":"0.1.1","from":"x","to":"z","line":1,"col":18},{"address":"0.2.1","from":"x","to":"z","line":2,"col":6}]},
    {"name":"rule pattern variable","source":"(rule copy (premise ?x) (conclusion ?x))\n","site":"0.2.1","to":"?y","expected":"(rule copy (premise ?y) (conclusion ?y))\n","canonical":"(rule copy (premise ?y) (conclusion ?y))\n","edits":[{"address":"0.2.1","from":"?x","to":"?y","line":1,"col":21},{"address":"0.3.1","from":"?x","to":"?y","line":1,"col":37}]},
    {"name":"rule pattern variable needs a pattern name","source":"(rule copy (premise ?x) (conclusion ?x))\n","site":"0.2.1","to":"y","error":"RML_RENAME_INVALID_NAME"},
    {"name":"global declaration and references across forms","source":"(T: (Type 0) T)\n(x: T)\n(lambda (T y) y)\n","site":"0","to":"U","expected":"(U: (Type 0) U)\n(x: U)\n(lambda (U y) y)\n","canonical":"(U: (Type 0) U)\n(x: U)\n(lambda (U y) y)\n","edits":[{"address":"0","from":"T","to":"U","line":1,"col":2},{"address":"0.1","from":"T","to":"U","line":1,"col":14},{"address":"1.0","from":"T","to":"U","line":2,"col":5},{"address":"2.1.0","from":"T","to":"U","line":3,"col":10}]},
    {"name":"declaration rename capturing a local binder","source":"(a: 1)\n(b: (lambda (Natural x) a))\n","site":"0","to":"x","error":"RML_RENAME_CAPTURE"},
    {"name":"declaration rename creating ambiguity","source":"(a: 1)\n(b: 2)\n(c: a)\n","site":"0","to":"b","error":"RML_RENAME_CAPTURE"},
    {"name":"ambiguous declarations are refused","source":"(a: 1)\n(a: 2)\n(b: a)\n","site":"0","to":"c","error":"RML_RENAME_AMBIGUOUS"},
    {"name":"keyword is not a binding name","source":"(lambda (Natural x) x)\n","site":"0.1.1","to":"lambda","error":"RML_RENAME_INVALID_NAME"},
    {"name":"literal is not a binding name","source":"(lambda (Natural x) x)\n","site":"0.1.1","to":"42","error":"RML_RENAME_INVALID_NAME"},
    {"name":"address that is not a binding","source":"(lambda (Natural x) x)\n","site":"0.2","to":"y","error":"RML_RENAME_NOT_BINDING"},
    {"name":"colon binder","source":"(lambda (x: Natural) (apply x x))\n","site":"0.1","to":"v","expected":"(lambda (v: Natural) (apply v v))\n","canonical":"(lambda (v: Natural) (apply v v))\n","edits":[{"address":"0.1","from":"x","to":"v","line":1,"col":10},{"address":"0.2.1","from":"x","to":"v","line":1,"col":29},{"address":"0.2.2","from":"x","to":"v","line":1,"col":31}]},
    {"name":"comma binder keeps its separator","source":"(lambda (Natural x, Natural y) (+ x y))\n","site":"0.1.1","to":"z","expected":"(lambda (Natural z, Natural y) (+ z y))\n","canonical":"(lambda (Natural z, Natural y) (+ z y))\n","edits":[{"address":"0.1.1","from":"x,","to":"z,","line":1,"col":18},{"address":"0.2.1","from":"x","to":"z","line":1,"col":35}]},
    {"name":"comma binder capture","source":"(lambda (Natural x, Natural y) (+ x y))\n","site":"0.1.1","to":"y","error":"RML_RENAME_CAPTURE"},
    {"name":"fresh binder","source":"(fresh x in (P x))\n","site":"0.1","to":"w","expected":"(fresh w in (P w))\n","canonical":"(fresh w in (P w))\n","edits":[{"address":"0.1","from":"x","to":"w","line":1,"col":8},{"address":"0.3.1","from":"x","to":"w","line":1,"col":16}]},
    {"name":"renamed name needing quotes","source":"(lambda (Natural x) x)\n","site":"0.1.1","to":"two words","expected":"(lambda (Natural 'two words') 'two words')\n","canonical":"(lambda (Natural 'two words') 'two words')\n","edits":[{"address":"0.1.1","from":"x","to":"two words","line":1,"col":18},{"address":"0.2","from":"x","to":"two words","line":1,"col":21}]},
    {"name":"no-op rename","source":"(lambda (Natural x) x)\n","site":"0.1.1","to":"x","expected":"(lambda (Natural x) x)\n","canonical":"(lambda (Natural x) x)\n","edits":[]}
  ]
}
