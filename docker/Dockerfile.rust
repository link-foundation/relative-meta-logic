# Multi-stage image for the Rust implementation of Relative Meta-Logic (RML).
#
# Build (from the repository root):
#   docker build -f docker/Dockerfile.rust -t rml-rust .
#
# Run the demo knowledge base:
#   docker run --rm rml-rust
#
# Run an arbitrary .lino file from the bundled examples:
#   docker run --rm rml-rust /repo/examples/classical-logic.lino
#
# Mount a local file to evaluate it:
#   docker run --rm -v "$PWD/my.lino:/work/my.lino" rml-rust /work/my.lino

# ---------- Build stage ----------
# Copy the supported Node runtime for the same lifecycle used outside Docker.
FROM node:22-bookworm-slim AS node-runtime
FROM rust:1-slim-bookworm AS builder
COPY --from=node-runtime /usr/local/bin/node /usr/local/bin/node
ENV RML_CACHE_SOURCE_ARCHIVE=1
# Required by the lifecycle guard; this is confined to the build stage.
# hadolint ignore=DL3008
RUN apt-get update \
    && apt-get install -y --no-install-recommends procps \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /build
# The ordinary lifecycle verifies the complete source/configuration inventory.
COPY . .
WORKDIR /build/rust

# Consume final binaries before cleanup, in the same layer as compilation.
# There is deliberately no persistent Cargo target cache mount or dummy build.
RUN node ../scripts/run-with-cache.mjs --isolate-output rust/target -- sh -ec \
    'cargo build --release --bin rml --bin rml-check --bin rml-meta; \
     mkdir -p /out; \
     cp "$RML_CACHE_OUTPUT_DIR/release/rml" "$RML_CACHE_OUTPUT_DIR/release/rml-check" "$RML_CACHE_OUTPUT_DIR/release/rml-meta" /out/' \
    && node ../scripts/build-cache.mjs --full

# ---------- Runtime stage ----------
FROM debian:bookworm-slim

# hadolint ignore=DL3008
RUN apt-get update \
    && apt-get install -y --no-install-recommends ca-certificates \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /repo

COPY --from=builder /out/rml /usr/local/bin/rml
COPY --from=builder /out/rml-check /usr/local/bin/rml-check
COPY --from=builder /out/rml-meta /usr/local/bin/rml-meta

COPY examples ./examples
COPY lib ./lib
COPY test-corpus ./test-corpus

ENTRYPOINT ["rml"]
CMD ["/repo/examples/demo.lino"]
