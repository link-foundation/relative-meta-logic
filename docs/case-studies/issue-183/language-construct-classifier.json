{
  "schema": "rml:language-construct-classifier:1",
  "description": "Every rule of the upstream native JavaScript, Rust, Lean and Rocq grammars is assigned exactly one coverage axis by the first matching pattern. A rule no pattern matches, or a pattern that matches no rule, fails the inventory check in both runtimes. Axis assignment is an audit classification, not a support claim.",
  "axes": {
    "grammar": "Lexical constructs: literals, identifiers' character classes, comments, escapes and token helpers.",
    "structure": "Program roots, statements, expressions, operators, application and blocks.",
    "scope": "Bindings, declarations that introduce names, parameters, binders and patterns.",
    "types": "Types, type parameters and bounds, algebraic data, records, classes, instances, universes and casts.",
    "modules": "Imports, exports, modules, namespaces, sections, paths and visibility.",
    "recursion": "Recursive definitions, fixpoints, loops, labels and iteration control.",
    "proofForms": "Theorems, proofs, tactics, proof terminators, obligations, assumptions and goal selection.",
    "runtime": "Runtime facilities and effects: exceptions, async, generators, monadic do-blocks, evaluation commands and unsafe code.",
    "standards": "Constructs gated by a language standard, edition or version (for example ES2026 resource management, Rust 2024 let chains, Lean module headers, Rocq attribute syntaxes).",
    "extensions": "Language extension mechanisms: macros, notations, syntax extensions, attributes, decorators, JSX, hints, extraction and embedded DSLs."
  },
