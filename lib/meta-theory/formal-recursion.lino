# Typed structural Nat/List elimination, independent of source declaration names.
# Import before formal-semantics together with formal-indexed and formal-records.
# This program deliberately imports nothing. Every motive and both branches are
# checked before elimination, even for zero, nil, and neutral targets. Generated
# dependent step types use ordinary Pi formation and lexical type closures.

(linked-program formal-recursion)

# Apply independently checked semantic values using the existing application
# machinery. These internal forms are not source-expression constructors.
(linked-rewrite formal-recursion apply-arrow
  (from (fs-rec-apply (fs-ok (fs-t-arrow ?domain ?codomain) ?function)
    (fs-ok ?domain ?argument) ?globals))
  (to (fs-application-argument ?domain ?codomain ?function
    (fs-ok ?domain ?argument) ?globals)))
(linked-rewrite formal-recursion apply-pi
  (from (fs-rec-apply (fs-ok (fs-t-pi ?domain ?codomain) ?function)
    (fs-ok ?domain ?argument) ?globals))
  (to (fs-pi-application-argument ?domain ?codomain ?function
    (fs-ok ?domain ?argument) ?globals)))
(linked-rewrite formal-recursion apply-function-error
  (from (fs-rec-apply (fs-error ?reason) ?argument ?globals))
  (to (fs-error ?reason)))
(linked-rewrite formal-recursion apply-argument-error
  (from (fs-rec-apply ?function (fs-error ?reason) ?globals))
  (to (fs-error ?reason)))

(linked-rewrite formal-recursion natural-recursion
  (from (fs-infer (fs-nat-rec ?motive ?base ?step ?target) ?locals ?globals))
  (to (fs-rec-nat-target ?motive ?base ?step ?locals ?globals
    (fs-check ?target fs-t-nat ?locals ?globals))))
(linked-rewrite formal-recursion natural-target
  (from (fs-rec-nat-target ?motive ?base ?step ?locals ?globals (fs-ok fs-t-nat ?target)))
  (to (fs-rec-nat-motive ?base ?step ?target ?locals ?globals
    (fs-check ?motive (fs-t-arrow fs-t-nat fs-kind) ?locals ?globals))))
(linked-rewrite formal-recursion natural-target-error
  (from (fs-rec-nat-target ?motive ?base ?step ?locals ?globals (fs-error ?reason)))
  (to (fs-error ?reason)))
(linked-rewrite formal-recursion natural-motive
  (from (fs-rec-nat-motive ?base ?step ?target ?locals ?globals
    (fs-ok (fs-t-arrow fs-t-nat fs-kind) ?motive)))
  (to (fs-rec-nat-base-type ?motive ?base ?step ?target ?locals ?globals
    (fs-rec-apply (fs-ok (fs-t-arrow fs-t-nat fs-kind) ?motive)
      (fs-ok fs-t-nat fs-v-zero) ?globals))))
(linked-rewrite formal-recursion natural-motive-error
  (from (fs-rec-nat-motive ?base ?step ?target ?locals ?globals (fs-error ?reason)))
  (to (fs-error ?reason)))
(linked-rewrite formal-recursion natural-base-type
  (from (fs-rec-nat-base-type ?motive ?base ?step ?target ?locals ?globals
    (fs-ok fs-kind ?type)))
  (to (fs-rec-nat-base ?motive ?step ?target ?locals ?globals
    (fs-check ?base ?type ?locals ?globals))))
(linked-rewrite formal-recursion natural-base-type-error
  (from (fs-rec-nat-base-type ?motive ?base ?step ?target ?locals ?globals (fs-error ?reason)))
  (to (fs-error ?reason)))

# With P saved at index 0: after k, P is 1 and k is 0; after ih,
# P is 2 and k is 1. Ghost bindings extend the caller's local context so
# formation introduces fresh levels even when P captures outer parameters.
(linked-rewrite formal-recursion natural-base
  (from (fs-rec-nat-base ?motive ?step ?target ?locals ?globals (fs-ok ?base-type ?base)))
  (to (fs-rec-nat-step-type ?motive (fs-ok ?base-type ?base) ?step ?target ?locals ?globals
    (fs-infer
      (fs-pi-type (fs-nat-type)
        (fs-pi-type
          (fs-apply (fs-variable (fs-index-next fs-index-zero)) (fs-variable fs-index-zero))
          (fs-apply (fs-variable (fs-index-next (fs-index-next fs-index-zero)))
            (fs-successor (fs-variable (fs-index-next fs-index-zero))))))
      (fs-bind (fs-t-arrow fs-t-nat fs-kind) ?motive ?locals) ?globals))))
(linked-rewrite formal-recursion natural-base-error
  (from (fs-rec-nat-base ?motive ?step ?target ?locals ?globals (fs-error ?reason)))
  (to (fs-error ?reason)))
(linked-rewrite formal-recursion natural-step-type
  (from (fs-rec-nat-step-type ?motive ?base ?step ?target ?locals ?globals (fs-ok fs-kind ?type)))
  (to (fs-rec-nat-step ?motive ?base ?target ?globals
    (fs-check ?step ?type ?locals ?globals))))
(linked-rewrite formal-recursion natural-step-type-error
  (from (fs-rec-nat-step-type ?motive ?base ?step ?target ?locals ?globals (fs-error ?reason)))
  (to (fs-error ?reason)))
(linked-rewrite formal-recursion natural-step
  (from (fs-rec-nat-step ?motive ?base ?target ?globals (fs-ok ?type ?step)))
  (to (fs-rec-nat-value ?motive ?base (fs-ok ?type ?step) ?target ?globals)))
(linked-rewrite formal-recursion natural-step-error
  (from (fs-rec-nat-step ?motive ?base ?target ?globals (fs-error ?reason)))
  (to (fs-error ?reason)))

# A separate view boundary permits a future checked binary representation to
# expose the same predecessor, without changing typing or adding recursion by
# source function name. Only structural predecessors are recursively visited.
(linked-rewrite formal-recursion natural-value
  (from (fs-rec-nat-value ?motive ?base ?step ?target ?globals))
  (to (fs-rec-nat-view-result ?motive ?base ?step ?target ?globals (fs-rec-nat-view ?target))))
(linked-rewrite formal-recursion natural-view-zero
  (from (fs-rec-nat-view fs-v-zero))
  (to fs-rec-nat-zero))
(linked-rewrite formal-recursion natural-view-successor
  (from (fs-rec-nat-view (fs-v-successor ?predecessor)))
  (to (fs-rec-nat-next ?predecessor)))
(linked-rewrite formal-recursion natural-view-neutral
  (from (fs-rec-nat-view (fs-neutral ?name)))
  (to (fs-rec-nat-neutral ?name)))
(linked-rewrite formal-recursion natural-zero
  (from (fs-rec-nat-view-result ?motive ?base ?step ?target ?globals fs-rec-nat-zero))
  (to ?base))
(linked-rewrite formal-recursion natural-successor
  (from (fs-rec-nat-view-result ?motive ?base ?step ?target ?globals (fs-rec-nat-next ?predecessor)))
  (to (fs-rec-apply
    (fs-rec-apply ?step (fs-ok fs-t-nat ?predecessor) ?globals)
    (fs-rec-nat-value ?motive ?base ?step ?predecessor ?globals) ?globals)))
(linked-rewrite formal-recursion natural-neutral
  (from (fs-rec-nat-view-result ?motive ?base ?step ?target ?globals (fs-rec-nat-neutral ?name)))
  (to (fs-rec-nat-neutral-type ?motive ?base ?step ?name
    (fs-rec-apply (fs-ok (fs-t-arrow fs-t-nat fs-kind) ?motive)
      (fs-ok fs-t-nat ?target) ?globals))))
(linked-rewrite formal-recursion natural-neutral-type
  (from (fs-rec-nat-neutral-type ?motive ?base ?step ?name (fs-ok fs-kind ?type)))
  (to (fs-ok ?type (fs-neutral (fs-neutral-nat-rec ?motive ?base ?step ?name)))))
(linked-rewrite formal-recursion natural-neutral-type-error
  (from (fs-rec-nat-neutral-type ?motive ?base ?step ?name (fs-error ?reason)))
  (to (fs-error ?reason)))

# The target supplies A independently. A source nil therefore needs a typed
# local/global or ordinary contextual application, just like fs-length/all.
(linked-rewrite formal-recursion list-recursion
  (from (fs-infer (fs-list-rec ?motive ?base ?step ?target) ?locals ?globals))
  (to (fs-rec-list-target ?motive ?base ?step ?locals ?globals
    (fs-infer ?target ?locals ?globals))))
(linked-rewrite formal-recursion list-target
  (from (fs-rec-list-target ?motive ?base ?step ?locals ?globals (fs-ok (fs-t-list ?element) ?target)))
  (to (fs-rec-list-motive ?element ?base ?step ?target ?locals ?globals
    (fs-check ?motive (fs-t-arrow (fs-t-list ?element) fs-kind) ?locals ?globals))))
(linked-rewrite formal-recursion list-target-not-list
  (from (fs-rec-list-target ?motive ?base ?step ?locals ?globals (fs-ok ?type ?target)))
  (to (fs-error expected-list)))
(linked-rewrite formal-recursion list-target-error
  (from (fs-rec-list-target ?motive ?base ?step ?locals ?globals (fs-error ?reason)))
  (to (fs-error ?reason)))
(linked-rewrite formal-recursion list-motive
  (from (fs-rec-list-motive ?element ?base ?step ?target ?locals ?globals
    (fs-ok (fs-t-arrow (fs-t-list ?element) fs-kind) ?motive)))
  (to (fs-rec-list-base-type ?element ?motive ?base ?step ?target ?locals ?globals
    (fs-rec-apply (fs-ok (fs-t-arrow (fs-t-list ?element) fs-kind) ?motive)
      (fs-ok (fs-t-list ?element) fs-v-nil) ?globals))))
(linked-rewrite formal-recursion list-motive-error
  (from (fs-rec-list-motive ?element ?base ?step ?target ?locals ?globals (fs-error ?reason)))
  (to (fs-error ?reason)))
(linked-rewrite formal-recursion list-base-type
  (from (fs-rec-list-base-type ?element ?motive ?base ?step ?target ?locals ?globals
    (fs-ok fs-kind ?type)))
  (to (fs-rec-list-base ?element ?motive ?step ?target ?locals ?globals
    (fs-check ?base ?type ?locals ?globals))))
(linked-rewrite formal-recursion list-base-type-error
  (from (fs-rec-list-base-type ?element ?motive ?base ?step ?target ?locals ?globals (fs-error ?reason)))
  (to (fs-error ?reason)))

# Saved: A at 0, P at 1. Under h: A at 1. Under tail: P at 3,
# tail at 0. Under ih: P at 4, h at 2, tail at 1. Thus the checked
# step is Pi h:A. Pi tail:List A. Pi ih:P tail. P(cons h tail).
(linked-rewrite formal-recursion list-base
  (from (fs-rec-list-base ?element ?motive ?step ?target ?locals ?globals (fs-ok ?base-type ?base)))
  (to (fs-rec-list-step-type ?element ?motive (fs-ok ?base-type ?base) ?step ?target ?locals ?globals
    (fs-infer
      (fs-pi-type (fs-variable fs-index-zero)
        (fs-pi-type (fs-list-type (fs-variable (fs-index-next fs-index-zero)))
          (fs-pi-type
            (fs-apply (fs-variable (fs-index-next (fs-index-next (fs-index-next fs-index-zero))))
              (fs-variable fs-index-zero))
            (fs-apply (fs-variable (fs-index-next (fs-index-next (fs-index-next (fs-index-next fs-index-zero)))))
              (fs-cons (fs-variable (fs-index-next (fs-index-next fs-index-zero)))
                (fs-variable (fs-index-next fs-index-zero)))))))
      (fs-bind fs-kind ?element
        (fs-bind (fs-t-arrow (fs-t-list ?element) fs-kind) ?motive ?locals)) ?globals))))
(linked-rewrite formal-recursion list-base-error
  (from (fs-rec-list-base ?element ?motive ?step ?target ?locals ?globals (fs-error ?reason)))
  (to (fs-error ?reason)))
(linked-rewrite formal-recursion list-step-type
  (from (fs-rec-list-step-type ?element ?motive ?base ?step ?target ?locals ?globals (fs-ok fs-kind ?type)))
  (to (fs-rec-list-step ?element ?motive ?base ?target ?globals
    (fs-check ?step ?type ?locals ?globals))))
(linked-rewrite formal-recursion list-step-type-error
  (from (fs-rec-list-step-type ?element ?motive ?base ?step ?target ?locals ?globals (fs-error ?reason)))
  (to (fs-error ?reason)))
(linked-rewrite formal-recursion list-step
  (from (fs-rec-list-step ?element ?motive ?base ?target ?globals (fs-ok ?type ?step)))
  (to (fs-rec-list-value ?element ?motive ?base (fs-ok ?type ?step) ?target ?globals)))
(linked-rewrite formal-recursion list-step-error
  (from (fs-rec-list-step ?element ?motive ?base ?target ?globals (fs-error ?reason)))
  (to (fs-error ?reason)))
(linked-rewrite formal-recursion list-nil
  (from (fs-rec-list-value ?element ?motive ?base ?step fs-v-nil ?globals))
  (to ?base))
(linked-rewrite formal-recursion list-cons
  (from (fs-rec-list-value ?element ?motive ?base ?step (fs-v-cons ?head ?tail) ?globals))
  (to (fs-rec-apply
    (fs-rec-apply
      (fs-rec-apply ?step (fs-ok ?element ?head) ?globals)
      (fs-ok (fs-t-list ?element) ?tail) ?globals)
    (fs-rec-list-value ?element ?motive ?base ?step ?tail ?globals) ?globals)))
(linked-rewrite formal-recursion list-neutral
  (from (fs-rec-list-value ?element ?motive ?base ?step (fs-neutral ?name) ?globals))
  (to (fs-rec-list-neutral-type ?element ?motive ?base ?step ?name
    (fs-rec-apply (fs-ok (fs-t-arrow (fs-t-list ?element) fs-kind) ?motive)
      (fs-ok (fs-t-list ?element) (fs-neutral ?name)) ?globals))))
(linked-rewrite formal-recursion list-neutral-type
  (from (fs-rec-list-neutral-type ?element ?motive ?base ?step ?name (fs-ok fs-kind ?type)))
  (to (fs-ok ?type (fs-neutral (fs-neutral-list-rec ?element ?motive ?base ?step ?name)))))
(linked-rewrite formal-recursion list-neutral-type-error
  (from (fs-rec-list-neutral-type ?element ?motive ?base ?step ?name (fs-error ?reason)))
  (to (fs-error ?reason)))
