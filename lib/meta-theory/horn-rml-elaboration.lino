# RML elaboration of linked-program documents as Horn clauses.
# Input: the generic LiNo forms of a document, every atom as UTF-8 bits, with
# no RML decision taken by the host. These clauses decide which forms declare
# programs, imports, rebindings, rewrites, facts and inferences, which atoms
# are pattern variables, which documents are rejected and why, and how the
# elaborated programs are passed to the linked reduce/prove workflows.
# Keyword spellings and the pattern-variable sigil are ordinary facts; editing
# one of them changes the language without touching any host code.

# The leading byte that marks a pattern variable: "?" (0x3F).
(horn-clause variable-sigil (variable-sigil (zero (zero (one (one (one (one (one (one end))))))))))

# A form is a keyword form when it is a list whose head atom spells the keyword.
(horn-clause has-keyword-list (has-keyword (list (cons (atom ?head) ?rest)) ?name ?answer)
  (keyword ?name ?bits) (code-equal ?head ?bits ?answer))
(horn-clause has-keyword-atom (has-keyword (atom ?bits) ?name no))
(horn-clause has-keyword-empty (has-keyword (list end) ?name no))
(horn-clause has-keyword-nested (has-keyword (list (cons (list ?items) ?rest)) ?name no))

# Pattern elaboration: an atom whose first byte is the sigil and that has
# further bytes is a variable named by those further bytes.
(horn-clause elaborate-atom (elaborate-pattern (atom ?bits) ?output)
  (take-bits (successor (successor (successor (successor (successor (successor (successor (successor zero)))))))) ?bits ?split)
  (variable-sigil ?sigil) (sigil-check ?split ?sigil ?bits ?output))
(horn-clause elaborate-list (elaborate-pattern (list ?items) (list ?output)) (elaborate-patterns ?items ?output))
(horn-clause elaborate-patterns-end (elaborate-patterns end end))
(horn-clause elaborate-patterns-next (elaborate-patterns (cons ?pattern ?rest) (cons ?elaborated ?output))
  (elaborate-pattern ?pattern ?elaborated) (elaborate-patterns ?rest ?output))
(horn-clause take-none (take-bits zero ?bits (byte end ?bits)))
(horn-clause take-short (take-bits (successor ?count) end short))
(horn-clause take-zero (take-bits (successor ?count) (zero ?tail) ?output)
  (take-bits ?count ?tail ?inner) (prefix-bit zero ?inner ?output))
(horn-clause take-one (take-bits (successor ?count) (one ?tail) ?output)
  (take-bits ?count ?tail ?inner) (prefix-bit one ?inner ?output))
(horn-clause prefix-short (prefix-bit ?bit short short))
(horn-clause prefix-byte (prefix-bit ?bit (byte ?prefix ?rest) (byte (?bit ?prefix) ?rest)))
(horn-clause sigil-short (sigil-check short ?sigil ?bits (atom ?bits)))
(horn-clause sigil-byte (sigil-check (byte ?first ?rest) ?sigil ?bits ?output)
  (code-equal ?first ?sigil ?same) (sigil-rest ?same ?rest ?bits ?output))
(horn-clause sigil-other (sigil-rest no ?rest ?bits (atom ?bits)))
(horn-clause sigil-alone (sigil-rest yes end ?bits (atom ?bits)))
(horn-clause sigil-variable-zero (sigil-rest yes (zero ?tail) ?bits (variable (zero ?tail))))
(horn-clause sigil-variable-one (sigil-rest yes (one ?tail) ?bits (variable (one ?tail))))

# Variables of elaborated patterns, and membership of binary codes.
(horn-clause variables-atom (pattern-variables (atom ?bits) ?seen ?seen))
(horn-clause variables-variable (pattern-variables (variable ?name) ?seen (cons ?name ?seen)))
(horn-clause variables-list (pattern-variables (list ?items) ?seen ?output) (patterns-variables ?items ?seen ?output))
(horn-clause variables-end (patterns-variables end ?seen ?seen))
(horn-clause variables-next (patterns-variables (cons ?pattern ?rest) ?seen ?output)
  (pattern-variables ?pattern ?seen ?middle) (patterns-variables ?rest ?middle ?output))
(horn-clause member-end (member-code ?code end no))
(horn-clause member-next (member-code ?code (cons ?head ?rest) ?found)
  (code-equal ?code ?head ?same) (member-choice ?same ?code ?rest ?found))
(horn-clause member-yes (member-choice yes ?code ?rest yes))
(horn-clause member-no (member-choice no ?code ?rest ?found) (member-code ?code ?rest ?found))

# Every variable of a replacement or conclusion must be bound on the left.
(horn-clause bound-atom (bound-check (atom ?bits) ?bound ok))
(horn-clause bound-variable (bound-check (variable ?name) ?bound ?status)
  (member-code ?name ?bound ?found) (bound-found ?found ?name ?status))
(horn-clause bound-found-yes (bound-found yes ?name ok))
(horn-clause bound-found-no (bound-found no ?name (rejected unbound-variable ?name)))
(horn-clause bound-list (bound-check (list ?items) ?bound ?status) (bound-checks ?items ?bound ?status))
(horn-clause bound-end (bound-checks end ?bound ok))
(horn-clause bound-next (bound-checks (cons ?pattern ?rest) ?bound ?status)
  (bound-check ?pattern ?bound ?first) (bound-then ?first ?rest ?bound ?status))
(horn-clause bound-then-ok (bound-then ok ?rest ?bound ?status) (bound-checks ?rest ?bound ?status))
(horn-clause bound-then-rejected (bound-then (rejected ?reason ?detail) ?rest ?bound (rejected ?reason ?detail)))

# Program declarations, imports and rebindings.
(horn-clause declared-end (declared-programs end end))
(horn-clause declared-next (declared-programs (cons ?form ?rest) ?output)
  (has-keyword ?form linked-program ?is) (declared-choice ?is ?form ?rest ?output))
(horn-clause declared-program (declared-choice yes (list (cons ?head (cons (atom ?name) ?clauses))) ?rest
  (cons (declared ?name ?clauses) ?output)) (declared-programs ?rest ?output))
(horn-clause declared-other (declared-choice no ?form ?rest ?output) (declared-programs ?rest ?output))
(horn-clause imports-end (program-imports end end))
(horn-clause imports-next (program-imports (cons (list (cons (atom ?head) (cons (atom ?dependency) ?rebinds))) ?rest)
  (cons (import ?dependency ?chain) ?output))
  (keyword uses ?head) (rebind-items ?rebinds ?chain) (program-imports ?rest ?output))
(horn-clause rebinds-end (rebind-items end end))
(horn-clause rebinds-next (rebind-items (cons (list (cons (atom ?head) (cons (atom ?from) (cons (atom ?to) end)))) ?rest)
  (cons (rebind ?from ?to) ?output))
  (keyword rebind ?head) (rebind-items ?rest ?output))
(horn-clause declaration-of (declaration-of ?name (cons (declared ?other ?clauses) ?rest) ?output)
  (code-equal ?name ?other ?same) (declaration-choice ?same ?name ?clauses ?rest ?output))
(horn-clause declaration-found (declaration-choice yes ?name ?clauses ?rest ?clauses))
(horn-clause declaration-later (declaration-choice no ?name ?clauses ?rest ?output) (declaration-of ?name ?rest ?output))
(horn-clause declared-names-end (declared-names end end))
(horn-clause declared-names-next (declared-names (cons (declared ?name ?clauses) ?rest) (cons ?name ?names))
  (declared-names ?rest ?names))

# Declarations in source order: no repeated program, dependency or rebind
# source, and no rebinding of a pattern variable.
(horn-clause declarations-end (check-declarations end ?earlier ok))
(horn-clause declarations-next (check-declarations (cons (declared ?name ?clauses) ?rest) ?earlier ?status)
  (member-code ?name ?earlier ?found) (declaration-status ?found ?name ?clauses ?rest ?earlier ?status))
(horn-clause declaration-duplicate (declaration-status yes ?name ?clauses ?rest ?earlier (rejected duplicate-program ?name)))
(horn-clause declaration-fresh (declaration-status no ?name ?clauses ?rest ?earlier ?status)
  (program-imports ?clauses ?imports) (imports-distinct ?imports end ?distinct)
  (declaration-next ?distinct ?rest (cons ?name ?earlier) ?status))
(horn-clause declaration-next-ok (declaration-next ok ?rest ?earlier ?status) (check-declarations ?rest ?earlier ?status))
(horn-clause declaration-next-rejected (declaration-next (rejected ?reason ?detail) ?rest ?earlier (rejected ?reason ?detail)))
(horn-clause imports-distinct-end (imports-distinct end ?seen ok))
(horn-clause imports-distinct-next (imports-distinct (cons (import ?dependency ?chain) ?rest) ?seen ?status)
  (member-code ?dependency ?seen ?found) (import-status ?found ?dependency ?chain ?rest ?seen ?status))
(horn-clause import-repeated (import-status yes ?dependency ?chain ?rest ?seen (rejected repeated-dependency ?dependency)))
(horn-clause import-fresh (import-status no ?dependency ?chain ?rest ?seen ?status)
  (rebinds-distinct ?chain end ?first) (import-next ?first ?rest (cons ?dependency ?seen) ?status))
(horn-clause import-next-ok (import-next ok ?rest ?seen ?status) (imports-distinct ?rest ?seen ?status))
(horn-clause import-next-rejected (import-next (rejected ?reason ?detail) ?rest ?seen (rejected ?reason ?detail)))
(horn-clause rebinds-distinct-end (rebinds-distinct end ?seen ok))
(horn-clause rebinds-distinct-next (rebinds-distinct (cons (rebind ?from ?to) ?rest) ?seen ?status)
  (elaborate-pattern (atom ?from) ?source) (elaborate-pattern (atom ?to) ?target)
  (rebind-kind ?source ?target ?kind) (rebind-status ?kind ?from ?rest ?seen ?status))
(horn-clause rebind-kind-atoms (rebind-kind (atom ?from) (atom ?to) atoms))
(horn-clause rebind-kind-source (rebind-kind (variable ?from) ?to variable))
(horn-clause rebind-kind-target (rebind-kind (atom ?from) (variable ?to) variable))
(horn-clause rebind-variable (rebind-status variable ?from ?rest ?seen (rejected rebind-variable ?from)))
(horn-clause rebind-atoms (rebind-status atoms ?from ?rest ?seen ?status)
  (member-code ?from ?seen ?found) (rebind-repeat ?found ?from ?rest ?seen ?status))
(horn-clause rebind-repeated (rebind-repeat yes ?from ?rest ?seen (rejected repeated-rebind ?from)))
(horn-clause rebind-fresh (rebind-repeat no ?from ?rest ?seen ?status) (rebinds-distinct ?rest (cons ?from ?seen) ?status))

# Rewrite, fact and inference forms. The from/to clauses may come in either order.
(horn-clause rewrite-from-to (rewrite-parts (list (cons ?head (cons (atom ?program) (cons (atom ?rule)
    (cons (list (cons (atom ?first) (cons ?pattern end))) (cons (list (cons (atom ?second) (cons ?replacement end))) end))))))
  ?program ?rule ?left ?right)
  (keyword from ?first) (keyword to ?second) (elaborate-pattern ?pattern ?left) (elaborate-pattern ?replacement ?right))
(horn-clause rewrite-to-from (rewrite-parts (list (cons ?head (cons (atom ?program) (cons (atom ?rule)
    (cons (list (cons (atom ?first) (cons ?replacement end))) (cons (list (cons (atom ?second) (cons ?pattern end))) end))))))
  ?program ?rule ?left ?right)
  (keyword to ?first) (keyword from ?second) (elaborate-pattern ?pattern ?left) (elaborate-pattern ?replacement ?right))
(horn-clause fact-parts (fact-parts (list (cons ?head (cons (atom ?program) (cons (atom ?fact)
    (cons (list (cons (atom ?judgement) (cons ?value end))) end)))))
  ?program ?fact ?value)
  (keyword judgement ?judgement))
(horn-clause inference-form-parts (inference-form-parts (list (cons ?head (cons (atom ?program) (cons (atom ?inference) ?clauses))))
  ?program ?inference ?premises ?conclusion)
  (inference-parts ?clauses ?premises (some ?conclusion)))
(horn-clause parts-end (inference-parts end end none))
(horn-clause parts-next (inference-parts (cons ?clause ?rest) ?premises ?conclusion)
  (has-keyword ?clause premise ?is) (inference-part ?is ?clause ?rest ?premises ?conclusion))
(horn-clause part-premise (inference-part yes (list (cons ?head (cons ?premise end))) ?rest (cons ?elaborated ?premises) ?conclusion)
  (elaborate-pattern ?premise ?elaborated) (inference-parts ?rest ?premises ?conclusion))
(horn-clause part-conclusion (inference-part no (list (cons (atom ?head) (cons ?value end))) ?rest ?premises (some ?elaborated))
  (keyword conclusion ?head) (elaborate-pattern ?value ?elaborated) (inference-parts ?rest ?premises none))

# Item validation in source order: a known owner, a fresh name per kind and
# owner, bound replacement/conclusion variables, ground facts, and a premise.
(horn-clause validate-end (validate-forms end ?names ?seen ok))
(horn-clause validate-next (validate-forms (cons ?form ?rest) ?names ?seen ?status)
  (has-keyword ?form linked-rewrite ?rewrite) (has-keyword ?form linked-fact ?fact)
  (has-keyword ?form linked-inference ?inference)
  (form-check ?rewrite ?fact ?inference ?form ?names ?seen ?check) (validate-then ?check ?rest ?names ?status))
(horn-clause validate-then-ok (validate-then (checked ?seen) ?rest ?names ?status) (validate-forms ?rest ?names ?seen ?status))
(horn-clause validate-then-rejected (validate-then (rejected ?reason ?detail) ?rest ?names (rejected ?reason ?detail)))
(horn-clause check-other (form-check no no no ?form ?names ?seen (checked ?seen)))
(horn-clause check-rewrite (form-check yes no no ?form ?names ?seen ?check)
  (rewrite-parts ?form ?program ?rule ?left ?right) (keyword linked-rewrite ?kind)
  (pattern-variables ?left end ?bound) (bound-check ?right ?bound ?content)
  (item-check ?program ?kind ?rule ?names ?seen ?content ?check))
(horn-clause check-fact (form-check no yes no ?form ?names ?seen ?check)
  (fact-parts ?form ?program ?fact ?value) (keyword linked-fact ?kind)
  (elaborate-pattern ?value ?pattern) (pattern-variables ?pattern end ?variables) (ground-fact ?variables ?content)
  (item-check ?program ?kind ?fact ?names ?seen ?content ?check))
(horn-clause check-inference (form-check no no yes ?form ?names ?seen ?check)
  (inference-form-parts ?form ?program ?inference ?premises ?conclusion) (keyword linked-inference ?kind)
  (patterns-variables ?premises end ?bound) (premise-check ?premises ?inference ?conclusion ?bound ?content)
  (item-check ?program ?kind ?inference ?names ?seen ?content ?check))
(horn-clause ground-fact (ground-fact end ok))
(horn-clause fact-variable (ground-fact (cons ?name ?rest) (rejected fact-variable ?name)))
(horn-clause premise-missing (premise-check end ?inference ?conclusion ?bound (rejected missing-premise ?inference)))
(horn-clause premise-present (premise-check (cons ?premise ?rest) ?inference ?conclusion ?bound ?status)
  (bound-check ?conclusion ?bound ?status))
(horn-clause item-check (item-check ?program ?kind ?name ?names ?seen ?content ?check)
  (member-code ?program ?names ?known) (owner-status ?known ?program ?kind ?name ?seen ?content ?check))
(horn-clause owner-unknown (owner-status no ?program ?kind ?name ?seen ?content (rejected unknown-program ?program)))
(horn-clause owner-known (owner-status yes ?program ?kind ?name ?seen ?content ?check)
  (seen-item ?kind ?program ?name ?seen ?found) (item-status ?found ?program ?kind ?name ?seen ?content ?check))
(horn-clause item-duplicate (item-status yes ?program ?kind ?name ?seen ?content (rejected duplicate-item ?name)))
(horn-clause item-fresh (item-status no ?program ?kind ?name ?seen ok (checked (cons (seen ?kind ?program ?name) ?seen))))
(horn-clause item-invalid (item-status no ?program ?kind ?name ?seen (rejected ?reason ?detail) (rejected ?reason ?detail)))
(horn-clause seen-end (seen-item ?kind ?program ?name end no))
(horn-clause seen-next (seen-item ?kind ?program ?name (cons (seen ?other-kind ?other-program ?other-name) ?rest) ?found)
  (code-equal ?kind ?other-kind ?same-kind) (code-equal ?program ?other-program ?same-program)
  (code-equal ?name ?other-name ?same-name) (all-yes ?same-kind ?same-program ?same-name ?same)
  (seen-choice ?same ?kind ?program ?name ?rest ?found))
(horn-clause all-yes (all-yes yes yes yes yes))
(horn-clause all-first-no (all-yes no ?second ?third no))
(horn-clause all-second-no (all-yes yes no ?third no))
(horn-clause all-third-no (all-yes yes yes no no))
(horn-clause seen-yes (seen-choice yes ?kind ?program ?name ?rest yes))
(horn-clause seen-no (seen-choice no ?kind ?program ?name ?rest ?found) (seen-item ?kind ?program ?name ?rest ?found))

# Imports name declared programs and do not form a cycle (depth first, in
# declaration order; the first program reached twice on one path is reported).
(horn-clause dependencies-end (dependencies-known end ?names ok))
(horn-clause dependencies-next (dependencies-known (cons (declared ?name ?clauses) ?rest) ?names ?status)
  (program-imports ?clauses ?imports) (imports-known ?imports ?names ?first) (dependencies-then ?first ?rest ?names ?status))
(horn-clause dependencies-then-ok (dependencies-then ok ?rest ?names ?status) (dependencies-known ?rest ?names ?status))
(horn-clause dependencies-then-rejected (dependencies-then (rejected ?reason ?detail) ?rest ?names (rejected ?reason ?detail)))
(horn-clause imports-known-end (imports-known end ?names ok))
(horn-clause imports-known-next (imports-known (cons (import ?dependency ?chain) ?rest) ?names ?status)
  (member-code ?dependency ?names ?found) (import-known ?found ?dependency ?rest ?names ?status))
(horn-clause import-known (import-known yes ?dependency ?rest ?names ?status) (imports-known ?rest ?names ?status))
(horn-clause import-unknown (import-known no ?dependency ?rest ?names (rejected unknown-dependency ?dependency)))
(horn-clause acyclic-end (acyclic end ?all ok))
(horn-clause acyclic-next (acyclic (cons (declared ?name ?clauses) ?rest) ?all ?status)
  (visit ?name end ?all ?first) (acyclic-then ?first ?rest ?all ?status))
(horn-clause acyclic-then-ok (acyclic-then ok ?rest ?all ?status) (acyclic ?rest ?all ?status))
(horn-clause acyclic-then-rejected (acyclic-then (rejected ?reason ?detail) ?rest ?all (rejected ?reason ?detail)))
(horn-clause visit (visit ?name ?path ?all ?status)
  (member-code ?name ?path ?found) (visit-choice ?found ?name ?path ?all ?status))
(horn-clause visit-cycle (visit-choice yes ?name ?path ?all (rejected import-cycle ?name)))
(horn-clause visit-fresh (visit-choice no ?name ?path ?all ?status)
  (declaration-of ?name ?all ?clauses) (program-imports ?clauses ?imports)
  (visit-imports ?imports (cons ?name ?path) ?all ?status))
(horn-clause visit-imports-end (visit-imports end ?path ?all ok))
(horn-clause visit-imports-next (visit-imports (cons (import ?dependency ?chain) ?rest) ?path ?all ?status)
  (visit ?dependency ?path ?all ?first) (visit-then ?first ?rest ?path ?all ?status))
(horn-clause visit-then-ok (visit-then ok ?rest ?path ?all ?status) (visit-imports ?rest ?path ?all ?status))
(horn-clause visit-then-rejected (visit-then (rejected ?reason ?detail) ?rest ?path ?all (rejected ?reason ?detail)))

# Rewrites, facts and inferences belonging to one program, in source order.
(horn-clause form-not-kind (form-owned no ?form ?name no))
(horn-clause form-kind (form-owned yes (list (cons ?head (cons (atom ?program) ?more))) ?name ?owned)
  (code-equal ?program ?name ?owned))
(horn-clause rules-end (collect-rules end ?name end))
(horn-clause rules-next (collect-rules (cons ?form ?rest) ?name ?output)
  (has-keyword ?form linked-rewrite ?is) (form-owned ?is ?form ?name ?owned) (rule-choice ?owned ?form ?rest ?name ?output))
(horn-clause rule-skip (rule-choice no ?form ?rest ?name ?output) (collect-rules ?rest ?name ?output))
(horn-clause rule-take (rule-choice yes ?form ?rest ?name (cons (rule (origin ?program ?rule) ?left ?right) ?output))
  (rewrite-parts ?form ?program ?rule ?left ?right) (collect-rules ?rest ?name ?output))
(horn-clause facts-end (collect-facts end ?name end))
(horn-clause facts-next (collect-facts (cons ?form ?rest) ?name ?output)
  (has-keyword ?form linked-fact ?is) (form-owned ?is ?form ?name ?owned) (fact-choice ?owned ?form ?rest ?name ?output))
(horn-clause fact-skip (fact-choice no ?form ?rest ?name ?output) (collect-facts ?rest ?name ?output))
(horn-clause fact-take (fact-choice yes ?form ?rest ?name (cons (fact (origin ?program ?fact) ?value) ?output))
  (fact-parts ?form ?program ?fact ?value) (collect-facts ?rest ?name ?output))
(horn-clause inferences-end (collect-inferences end ?name end))
(horn-clause inferences-next (collect-inferences (cons ?form ?rest) ?name ?output)
  (has-keyword ?form linked-inference ?is) (form-owned ?is ?form ?name ?owned) (inference-choice ?owned ?form ?rest ?name ?output))
(horn-clause inference-skip (inference-choice no ?form ?rest ?name ?output) (collect-inferences ?rest ?name ?output))
(horn-clause inference-take (inference-choice yes ?form ?rest ?name
  (cons (inference (origin ?program ?inference) ?premises ?conclusion) ?output))
  (inference-form-parts ?form ?program ?inference ?premises ?conclusion) (collect-inferences ?rest ?name ?output))
(horn-clause programs-end (build-programs end ?forms end))
(horn-clause programs-next (build-programs (cons (declared ?name ?clauses) ?rest) ?forms
  (cons (program ?name ?rules ?facts ?inferences ?imports) ?output))
  (program-imports ?clauses ?imports) (collect-rules ?forms ?name ?rules) (collect-facts ?forms ?name ?facts)
  (collect-inferences ?forms ?name ?inferences) (build-programs ?rest ?forms ?output))

# A document elaborates to programs, or is rejected with a linked reason.
# A form that matches none of the shapes above has no elaboration at all.
(horn-clause elaborate (elaborate ?forms ?result)
  (declared-programs ?forms ?declarations) (declared-names ?declarations ?names)
  (check-declarations ?declarations end ?declared)
  (elaborate-declared ?declared ?forms ?declarations ?names ?result))
(horn-clause elaborate-declared-rejected (elaborate-declared (rejected ?reason ?detail) ?forms ?declarations ?names
  (rejected ?reason ?detail)))
(horn-clause elaborate-declared-ok (elaborate-declared ok ?forms ?declarations ?names ?result)
  (validate-forms ?forms ?names end ?validated) (elaborate-validated ?validated ?forms ?declarations ?names ?result))
(horn-clause elaborate-validated-rejected (elaborate-validated (rejected ?reason ?detail) ?forms ?declarations ?names
  (rejected ?reason ?detail)))
(horn-clause elaborate-validated-ok (elaborate-validated ok ?forms ?declarations ?names ?result)
  (dependencies-known ?declarations ?names ?known) (elaborate-known ?known ?forms ?declarations ?result))
(horn-clause elaborate-known-rejected (elaborate-known (rejected ?reason ?detail) ?forms ?declarations (rejected ?reason ?detail)))
(horn-clause elaborate-known-ok (elaborate-known ok ?forms ?declarations ?result)
  (acyclic ?declarations ?declarations ?acyclic) (elaborate-acyclic ?acyclic ?forms ?declarations ?result))
(horn-clause elaborate-acyclic-rejected (elaborate-acyclic (rejected ?reason ?detail) ?forms ?declarations (rejected ?reason ?detail)))
(horn-clause elaborate-acyclic-ok (elaborate-acyclic ok ?forms ?declarations (elaborated ?programs))
  (build-programs ?declarations ?forms ?programs))

# Source workflows: elaborate, then run the linked workflows.
(horn-clause reduce-source (rml-reduce-source ?forms ?name ?input ?fuel ?result)
  (elaborate ?forms ?elaborated) (reduce-elaborated ?elaborated ?name ?input ?fuel ?result))
(horn-clause reduce-source-rejected (reduce-elaborated (rejected ?reason ?detail) ?name ?input ?fuel (rejected ?reason ?detail)))
(horn-clause reduce-source-accepted (reduce-elaborated (elaborated ?programs) ?name ?input ?fuel ?result)
  (rml-reduce ?programs ?name ?input ?fuel ?result))
(horn-clause prove-source (rml-prove-source ?forms ?name ?goal ?absent ?fuel ?result)
  (elaborate ?forms ?elaborated) (prove-elaborated ?elaborated ?name ?goal ?absent ?fuel ?result))
(horn-clause prove-source-rejected (prove-elaborated (rejected ?reason ?detail) ?name ?goal ?absent ?fuel (rejected ?reason ?detail)))
(horn-clause prove-source-accepted (prove-elaborated (elaborated ?programs) ?name ?goal ?absent ?fuel ?result)
  (rml-prove ?programs ?name ?goal ?absent ?fuel ?result))

# Keyword spellings as UTF-8 bits (generated once from their text; these facts are authoritative).
(horn-clause spell-end (spell end end))
(horn-clause spell-byte (spell (cons (byte ?a ?b ?c ?d ?e ?f ?g ?h) ?rest) (?a (?b (?c (?d (?e (?f (?g (?h ?tail)))))))))
  (spell ?rest ?tail))
(horn-clause keyword-linked-program (keyword linked-program ?bits)
  (spell (cons (byte zero one one zero one one zero zero) (cons (byte zero one one zero one zero zero one) (cons (byte zero one one zero one one one zero) (cons (byte zero one one zero one zero one one) (cons (byte zero one one zero zero one zero one) (cons (byte zero one one zero zero one zero zero) (cons (byte zero zero one zero one one zero one) (cons (byte zero one one one zero zero zero zero) (cons (byte zero one one one zero zero one zero) (cons (byte zero one one zero one one one one) (cons (byte zero one one zero zero one one one) (cons (byte zero one one one zero zero one zero) (cons (byte zero one one zero zero zero zero one) (cons (byte zero one one zero one one zero one) end)))))))))))))) ?bits))
(horn-clause keyword-uses (keyword uses ?bits)
  (spell (cons (byte zero one one one zero one zero one) (cons (byte zero one one one zero zero one one) (cons (byte zero one one zero zero one zero one) (cons (byte zero one one one zero zero one one) end)))) ?bits))
(horn-clause keyword-rebind (keyword rebind ?bits)
