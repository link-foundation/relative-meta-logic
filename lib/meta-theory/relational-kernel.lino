# Authoritative upper semantics for the first-order Horn resolution candidate.
# The host only resolves Horn clauses and unifies finite first-order terms.
# Matching, substitution, traversal and the following predicates are source.

(horn-clause bits-empty (bits-equal end end yes))
(horn-clause bits-empty-zero (bits-equal end (zero ?tail) no))
(horn-clause bits-empty-one (bits-equal end (one ?tail) no))
(horn-clause bits-zero-empty (bits-equal (zero ?tail) end no))
(horn-clause bits-one-empty (bits-equal (one ?tail) end no))
(horn-clause bits-zero-one (bits-equal (zero ?a) (one ?b) no))
(horn-clause bits-one-zero (bits-equal (one ?a) (zero ?b) no))
(horn-clause bits-zero (bits-equal (zero ?a) (zero ?b) ?result) (bits-equal ?a ?b ?result))
(horn-clause bits-one (bits-equal (one ?a) (one ?b) ?result) (bits-equal ?a ?b ?result))

(horn-clause equal-atoms (nodes-equal (atom ?a) (atom ?b) ?result) (bits-equal ?a ?b ?result))
(horn-clause unequal-atom-list (nodes-equal (atom ?a) (list ?b) no))
(horn-clause unequal-list-atom (nodes-equal (list ?a) (atom ?b) no))
(horn-clause equal-lists (nodes-equal (list ?a) (list ?b) ?result) (node-lists-equal ?a ?b ?result))
(horn-clause equal-empty-lists (node-lists-equal end end yes))
(horn-clause unequal-empty-left (node-lists-equal end (cons ?x ?xs) no))
(horn-clause unequal-empty-right (node-lists-equal (cons ?x ?xs) end no))
(horn-clause compare-list-head (node-lists-equal (cons ?a ?as) (cons ?b ?bs) ?result)
  (nodes-equal ?a ?b ?same) (equal-list-tail ?same ?as ?bs ?result))
(horn-clause unequal-list-head (equal-list-tail no ?as ?bs no))
(horn-clause equal-list-head (equal-list-tail yes ?as ?bs ?result) (node-lists-equal ?as ?bs ?result))

(horn-clause lookup-empty (lookup ?name end absent))
(horn-clause lookup-binding (lookup ?name (cons (binding ?bound ?value) ?tail) ?result)
  (bits-equal ?name ?bound ?same) (lookup-choice ?same ?name ?value ?tail ?result))
(horn-clause lookup-found (lookup-choice yes ?name ?value ?tail (present ?value)))
(horn-clause lookup-next (lookup-choice no ?name ?value ?tail ?result) (lookup ?name ?tail ?result))

(horn-clause match-variable (match (variable ?name) ?node ?environment ?result)
  (lookup ?name ?environment ?found) (bind-pattern ?found ?name ?node ?environment ?result))
(horn-clause bind-new (bind-pattern absent ?name ?node ?environment (matched (cons (binding ?name ?node) ?environment))))
(horn-clause bind-repeated (bind-pattern (present ?bound) ?name ?node ?environment ?result)
  (nodes-equal ?bound ?node ?same) (match-decision ?same ?environment ?result))
(horn-clause match-yes (match-decision yes ?environment (matched ?environment)))
(horn-clause match-no (match-decision no ?environment failed))
(horn-clause match-atoms (match (atom ?a) (atom ?b) ?environment ?result)
  (bits-equal ?a ?b ?same) (match-decision ?same ?environment ?result))
(horn-clause match-atom-list (match (atom ?a) (list ?b) ?environment failed))
(horn-clause match-list-atom (match (list ?a) (atom ?b) ?environment failed))
(horn-clause match-lists (match (list ?a) (list ?b) ?environment ?result)
  (match-items ?a ?b ?environment ?result))
(horn-clause match-empty (match-items end end ?environment (matched ?environment)))
(horn-clause match-short-left (match-items end (cons ?b ?bs) ?environment failed))
(horn-clause match-short-right (match-items (cons ?a ?as) end ?environment failed))
(horn-clause match-head (match-items (cons ?a ?as) (cons ?b ?bs) ?environment ?result)
  (match ?a ?b ?environment ?head) (match-tail ?head ?as ?bs ?result))
(horn-clause match-tail-failed (match-tail failed ?as ?bs failed))
(horn-clause match-tail-next (match-tail (matched ?environment) ?as ?bs ?result)
  (match-items ?as ?bs ?environment ?result))

(horn-clause substitute-variable (substitute (variable ?name) ?environment ?result)
  (lookup ?name ?environment (present ?result)))
(horn-clause substitute-atom (substitute (atom ?name) ?environment (atom ?name)))
(horn-clause substitute-list (substitute (list ?items) ?environment (list ?result))
  (substitute-items ?items ?environment ?result))
(horn-clause substitute-empty (substitute-items end ?environment end))
(horn-clause substitute-head (substitute-items (cons ?head ?tail) ?environment (cons ?result ?rest))
  (substitute ?head ?environment ?result) (substitute-items ?tail ?environment ?rest))

(horn-clause choose-none (choose-rewrite end ?node none))
(horn-clause choose-rule (choose-rewrite (cons (rule ?name ?pattern ?replacement) ?rules) ?node ?result)
  (match ?pattern ?node end ?matched) (choose-matched ?matched ?name ?replacement ?rules ?node ?result))
(horn-clause choose-match (choose-matched (matched ?environment) ?name ?replacement ?rules ?node (some (step ?result ?name)))
  (substitute ?replacement ?environment ?result))
(horn-clause choose-next (choose-matched failed ?name ?replacement ?rules ?node ?result)
  (choose-rewrite ?rules ?node ?result))
(horn-clause rewrite-root (rewrite-once ?rules ?node ?result)
  (choose-rewrite ?rules ?node ?root) (rewrite-root-choice ?root ?rules ?node ?result))
(horn-clause rewrite-root-found (rewrite-root-choice (some ?step) ?rules ?node (some ?step)))
(horn-clause rewrite-leaf (rewrite-root-choice none ?rules (atom ?value) none))
(horn-clause rewrite-children (rewrite-root-choice none ?rules (list ?items) ?result)
  (rewrite-items ?rules ?items ?changed) (wrap-items-step ?changed ?result))
(horn-clause wrap-no-step (wrap-items-step none none))
(horn-clause wrap-step (wrap-items-step (some (step ?items ?name)) (some (step (list ?items) ?name))))
(horn-clause rewrite-items-empty (rewrite-items ?rules end none))
(horn-clause rewrite-items-head (rewrite-items ?rules (cons ?head ?tail) ?result)
  (rewrite-once ?rules ?head ?changed) (rewrite-items-choice ?changed ?rules ?head ?tail ?result))
(horn-clause rewrite-items-found (rewrite-items-choice (some (step ?head ?name)) ?rules ?original ?tail
  (some (step (cons ?head ?tail) ?name))))
(horn-clause rewrite-items-next (rewrite-items-choice none ?rules ?head ?tail ?result)
  (rewrite-items ?rules ?tail ?changed) (prepend-items-step ?head ?changed ?result))
(horn-clause prepend-none (prepend-items-step ?head none none))
(horn-clause prepend-step (prepend-items-step ?head (some (step ?tail ?name)) (some (step (cons ?head ?tail) ?name))))

(horn-clause append-empty (append end ?right ?right))
(horn-clause append-next (append (cons ?head ?tail) ?right (cons ?head ?rest)) (append ?tail ?right ?rest))

# Normalization is an authored relation; fuel makes its stopping rule explicit.
(horn-clause normalize-start (normalize ?rules ?node ?fuel ?result)
  (rewrite-once ?rules ?node ?step) (normalize-step ?step ?rules ?node ?fuel ?result))
(horn-clause normalize-done (normalize-step none ?rules ?node ?fuel (normal ?node)))
(horn-clause normalize-limit (normalize-step (some ?step) ?rules ?node zero (limit ?node)))
(horn-clause normalize-more (normalize-step (some (step ?next ?name)) ?rules ?node (successor ?fuel) ?result)
  (normalize ?rules ?next ?fuel ?result))

# Imports and rebinding are linked relations, including lookup and cycle outcomes.
(horn-clause program-lookup-empty (program-lookup ?name end absent))
(horn-clause program-lookup-next (program-lookup ?name (cons (program ?other ?rules ?facts ?inferences ?imports) ?tail) ?result)
  (bits-equal ?name ?other ?same)
  (program-lookup-choice ?same ?name (program ?other ?rules ?facts ?inferences ?imports) ?tail ?result))
(horn-clause program-lookup-found (program-lookup-choice yes ?name ?program ?tail (present ?program)))
(horn-clause program-lookup-skip (program-lookup-choice no ?name ?program ?tail ?result) (program-lookup ?name ?tail ?result))
(horn-clause name-not-seen (name-member ?name end no))
(horn-clause name-test (name-member ?name (cons ?head ?tail) ?result)
  (bits-equal ?name ?head ?same) (name-member-choice ?same ?name ?tail ?result))
(horn-clause name-seen (name-member-choice yes ?name ?tail yes))
(horn-clause name-continue (name-member-choice no ?name ?tail ?result) (name-member ?name ?tail ?result))
(horn-clause select-rewrites (program-part rewrites (program ?name ?rules ?facts ?inferences ?imports) ?rules))
(horn-clause select-facts (program-part facts (program ?name ?rules ?facts ?inferences ?imports) ?facts))
(horn-clause select-inferences (program-part inferences (program ?name ?rules ?facts ?inferences ?imports) ?inferences))
(horn-clause resolve-program (resolve ?programs ?name ?kind ?seen ?result)
  (name-member ?name ?seen ?cycle) (resolve-cycle-choice ?cycle ?programs ?name ?kind ?seen ?result))
(horn-clause resolve-cycle (resolve-cycle-choice yes ?programs ?name ?kind ?seen (error cycle)))
(horn-clause resolve-not-cycle (resolve-cycle-choice no ?programs ?name ?kind ?seen ?result)
  (program-lookup ?name ?programs ?found) (resolve-found ?found ?programs ?kind (cons ?name ?seen) ?result))
(horn-clause resolve-missing (resolve-found absent ?programs ?kind ?seen (error missing)))
(horn-clause resolve-present (resolve-found (present (program ?name ?rules ?facts ?inferences ?imports)) ?programs ?kind ?seen ?result)
  (resolve-imports ?programs ?imports ?kind ?seen ?inherited)
  (program-part ?kind (program ?name ?rules ?facts ?inferences ?imports) ?own)
  (resolve-combine ?inherited ?own ?result))
(horn-clause resolve-combine-error (resolve-combine (error ?reason) ?own (error ?reason)))
(horn-clause resolve-combine-items (resolve-combine (resolved ?inherited) ?own (resolved ?items)) (append ?inherited ?own ?items))
(horn-clause resolve-imports-empty (resolve-imports ?programs end ?kind ?seen (resolved end)))
(horn-clause resolve-imports-next (resolve-imports ?programs (cons (import ?name ?rebindings) ?tail) ?kind ?seen ?result)
  (resolve ?programs ?name ?kind ?seen ?head)
  (resolve-import-head ?head ?rebindings ?programs ?tail ?kind ?seen ?result))
(horn-clause resolve-import-error (resolve-import-head (error ?reason) ?rebindings ?programs ?tail ?kind ?seen (error ?reason)))
(horn-clause resolve-import-renamed (resolve-import-head (resolved ?items) ?rebindings ?programs ?tail ?kind ?seen ?result)
  (rename-items ?kind ?items ?rebindings ?renamed)
  (resolve-imports ?programs ?tail ?kind ?seen ?rest)
  (resolve-prepend ?renamed ?rest ?result))
(horn-clause resolve-prepend-error (resolve-prepend ?head (error ?reason) (error ?reason)))
(horn-clause resolve-prepend-items (resolve-prepend ?head (resolved ?tail) (resolved ?items)) (append ?head ?tail ?items))

(horn-clause rename-symbol-empty (rename-symbol ?name end ?name))
(horn-clause rename-symbol-next (rename-symbol ?name (cons (rebind ?from ?to) ?tail) ?result)
  (bits-equal ?name ?from ?same) (rename-symbol-choice ?same ?name ?to ?tail ?result))
(horn-clause rename-symbol-found (rename-symbol-choice yes ?name ?to ?tail ?to))
(horn-clause rename-symbol-skip (rename-symbol-choice no ?name ?to ?tail ?result) (rename-symbol ?name ?tail ?result))
(horn-clause rename-variable (rename-node (variable ?name) ?rebindings (variable ?name)))
(horn-clause rename-atom (rename-node (atom ?name) ?rebindings (atom ?result)) (rename-symbol ?name ?rebindings ?result))
(horn-clause rename-list (rename-node (list ?items) ?rebindings (list ?result)) (rename-nodes ?items ?rebindings ?result))
(horn-clause rename-nodes-empty (rename-nodes end ?rebindings end))
(horn-clause rename-nodes-next (rename-nodes (cons ?head ?tail) ?rebindings (cons ?renamed ?rest))
  (rename-node ?head ?rebindings ?renamed) (rename-nodes ?tail ?rebindings ?rest))
(horn-clause rename-items-empty (rename-items ?kind end ?rebindings end))
(horn-clause rename-items-next (rename-items ?kind (cons ?head ?tail) ?rebindings (cons ?renamed ?rest))
  (rename-item ?kind ?head ?rebindings ?renamed) (rename-items ?kind ?tail ?rebindings ?rest))
(horn-clause rename-rule (rename-item rewrites (rule ?name ?pattern ?replacement) ?rebindings (rule ?name ?new-pattern ?new-replacement))
  (rename-node ?pattern ?rebindings ?new-pattern) (rename-node ?replacement ?rebindings ?new-replacement))
(horn-clause rename-fact (rename-item facts (fact ?name ?judgement) ?rebindings (fact ?name ?renamed))
  (rename-node ?judgement ?rebindings ?renamed))
(horn-clause rename-inference (rename-item inferences (inference ?name ?premises ?conclusion) ?rebindings (inference ?name ?new-premises ?new-conclusion))
  (rename-nodes ?premises ?rebindings ?new-premises) (rename-node ?conclusion ?rebindings ?new-conclusion))

# Known judgements carry proof trees; duplicates are checked through linked equality.
(horn-clause known-absent (known-proof ?judgement end none))
(horn-clause known-next (known-proof ?judgement (cons (known ?other ?proof) ?tail) ?result)
  (nodes-equal ?judgement ?other ?same) (known-choice ?same ?judgement ?proof ?tail ?result))
(horn-clause known-found (known-choice yes ?judgement ?proof ?tail (some ?proof)))
(horn-clause known-skip (known-choice no ?judgement ?proof ?tail ?result) (known-proof ?judgement ?tail ?result))
(horn-clause add-facts-empty (add-facts end ?rules ?fuel ?known ?known))
(horn-clause add-facts-next (add-facts (cons (fact ?name ?judgement) ?tail) ?rules ?fuel ?known ?result)
  (normalize ?rules ?judgement ?fuel (normal ?normal))
  (known-proof ?normal ?known ?found)
  (add-fact-choice ?found ?name ?normal ?known ?next)
  (add-facts ?tail ?rules ?fuel ?next ?result))
(horn-clause add-fact-existing (add-fact-choice (some ?proof) ?name ?normal ?known ?known))
(horn-clause add-fact-new (add-fact-choice none ?name ?normal ?known ?result)
  (append ?known (cons (known ?normal (proof ?name ?normal end)) end) ?result))

# Each inference enumerates premise matches relationally, in declared order.
(horn-clause solve-premises-empty (solve-premises end ?known ?environment ?environment end))
(horn-clause solve-premises-next (solve-premises (cons ?pattern ?patterns) ?known ?environment ?result (cons ?proof ?proofs))
  (choose-premise ?pattern ?known ?environment ?next ?proof)
  (solve-premises ?patterns ?known ?next ?result ?proofs))
(horn-clause choose-premise-here (choose-premise ?pattern (cons (known ?judgement ?proof) ?tail) ?environment ?result ?proof)
  (match ?pattern ?judgement ?environment (matched ?result)))
(horn-clause choose-premise-later (choose-premise ?pattern (cons ?entry ?tail) ?environment ?result ?proof)
  (choose-premise ?pattern ?tail ?environment ?result ?proof))
(horn-clause infer-rule (infer-candidate (inference ?name ?premises ?conclusion) ?known ?rules ?fuel ?result)
  (solve-premises ?premises ?known end ?environment ?proofs)
  (substitute ?conclusion ?environment ?judgement)
  (normalize ?rules ?judgement ?fuel ?normalized)
  (infer-normalized ?normalized ?name ?known ?proofs ?result))
(horn-clause infer-normalized (infer-normalized (normal ?normal) ?name ?known ?proofs (derived ?normal (proof ?name ?normal ?proofs)))
  (known-proof ?normal ?known none))
(horn-clause infer-normalization-limit (infer-normalized (limit ?node) ?name ?known ?proofs (blocked normalization-limit ?node)))
# Rotate the successful rule behind remaining and previously skipped rules.
(horn-clause infer-start (infer-step ?inferences ?known ?rules ?fuel ?result)
  (infer-cursor ?inferences end ?known ?rules ?fuel ?result))
(horn-clause infer-first-rule (infer-cursor (cons ?rule ?remaining) ?skipped ?known ?rules ?fuel ?result)
  (infer-candidate ?rule ?known ?rules ?fuel ?candidate)
  (infer-cursor-choice ?candidate ?rule ?remaining ?skipped ?result))
(horn-clause infer-later-rule (infer-cursor (cons ?rule ?remaining) ?skipped ?known ?rules ?fuel ?result)
  (append ?skipped (cons ?rule end) ?next-skipped)
  (infer-cursor ?remaining ?next-skipped ?known ?rules ?fuel ?result))
(horn-clause infer-cursor-derived (infer-cursor-choice (derived ?judgement ?proof) ?rule ?remaining ?skipped (transition (derived ?judgement ?proof) ?next))
  (append ?skipped (cons ?rule end) ?last)
  (append ?remaining ?last ?next))
(horn-clause infer-cursor-blocked (infer-cursor-choice (blocked ?reason ?node) ?rule ?remaining ?skipped (blocked ?reason ?node)))

# A source-authored interpreter for quoted Horn clauses, including its own
# first-order unifier, occurs check, environments and clause freshening.
# It is a higher interpreter above the explicitly retained host Horn boundary.
(horn-clause scopes-compare (scopes-equal ?left ?right ?result) (bits-equal ?left ?right ?result))
(horn-clause scope-next-empty (scope-next end (one end)))
(horn-clause scope-next-zero (scope-next (zero ?tail) (one ?tail)))
(horn-clause scope-next-one (scope-next (one ?tail) (zero ?next)) (scope-next ?tail ?next))
(horn-clause keys-compare (keys-equal (key ?scope ?name) (key ?other ?value) ?result)
  (scopes-equal ?scope ?other ?same) (keys-names ?same ?name ?value ?result))
(horn-clause keys-other-scope (keys-names no ?name ?value no))
(horn-clause keys-same-scope (keys-names yes ?name ?value ?result) (bits-equal ?name ?value ?result))
# Persistent binary tries keep interpretation practical. All traversal and
# insertion laws live here; the host does not know environment constructors.
(horn-clause trie-read-empty (trie-read end ?bits absent))
(horn-clause trie-read-slot (trie-read (branch ?slot ?left ?right) end ?slot))
(horn-clause trie-read-zero (trie-read (branch ?slot ?left ?right) (zero ?tail) ?result) (trie-read ?left ?tail ?result))
(horn-clause trie-read-one (trie-read (branch ?slot ?left ?right) (one ?tail) ?result) (trie-read ?right ?tail ?result))
(horn-clause trie-write-empty (trie-write end ?bits ?value ?result) (trie-write (branch absent end end) ?bits ?value ?result))
(horn-clause trie-write-slot (trie-write (branch ?slot ?left ?right) end ?value (branch (present ?value) ?left ?right)))
(horn-clause trie-write-zero (trie-write (branch ?slot ?left ?right) (zero ?tail) ?value (branch ?slot ?next ?right))
  (trie-write ?left ?tail ?value ?next))
(horn-clause trie-write-one (trie-write (branch ?slot ?left ?right) (one ?tail) ?value (branch ?slot ?left ?next))
  (trie-write ?right ?tail ?value ?next))
(horn-clause meta-lookup-scope (meta-lookup (key ?scope ?name) ?environment ?result)
  (trie-read ?environment ?scope ?names) (meta-lookup-names ?names ?name ?result))
(horn-clause meta-lookup-no-scope (meta-lookup-names absent ?name absent))
(horn-clause meta-lookup-present-scope (meta-lookup-names (present ?names) ?name ?result) (trie-read ?names ?name ?result))
(horn-clause meta-store-scope (meta-store (key ?scope ?name) ?value ?environment ?result)
  (trie-read ?environment ?scope ?names) (meta-store-names ?names ?name ?value ?updated)
  (trie-write ?environment ?scope ?updated ?result))
(horn-clause meta-store-empty-names (meta-store-names absent ?name ?value ?result) (trie-write end ?name ?value ?result))
(horn-clause meta-store-existing-names (meta-store-names (present ?names) ?name ?value ?result) (trie-write ?names ?name ?value ?result))
(horn-clause meta-walk-atom (meta-walk (meta-atom ?name) ?environment (meta-atom ?name)))
(horn-clause meta-walk-list (meta-walk (meta-list ?items) ?environment (meta-list ?items)))
(horn-clause meta-walk-variable (meta-walk (meta-variable ?key) ?environment ?result)
  (meta-lookup ?key ?environment ?found) (meta-walk-found ?found ?key ?environment ?result))
(horn-clause meta-walk-unbound (meta-walk-found absent ?key ?environment (meta-variable ?key)))
(horn-clause meta-walk-bound (meta-walk-found (present ?value) ?key ?environment ?result) (meta-walk ?value ?environment ?result))
(horn-clause meta-occurs (meta-occurs ?key ?value ?environment ?result)
  (meta-walk ?value ?environment ?walked) (meta-occurs-walked ?key ?walked ?environment ?result))
(horn-clause meta-occurs-variable (meta-occurs-walked ?key (meta-variable ?other) ?environment ?result) (keys-equal ?key ?other ?result))
(horn-clause meta-occurs-atom (meta-occurs-walked ?key (meta-atom ?name) ?environment no))
(horn-clause meta-occurs-list (meta-occurs-walked ?key (meta-list ?items) ?environment ?result) (meta-occurs-items ?key ?items ?environment ?result))
(horn-clause meta-occurs-empty (meta-occurs-items ?key end ?environment no))
(horn-clause meta-occurs-head (meta-occurs-items ?key (cons ?head ?tail) ?environment ?result)
  (meta-occurs ?key ?head ?environment ?found) (meta-occurs-tail ?found ?key ?tail ?environment ?result))
(horn-clause meta-occurs-yes (meta-occurs-tail yes ?key ?tail ?environment yes))
(horn-clause meta-occurs-next (meta-occurs-tail no ?key ?tail ?environment ?result) (meta-occurs-items ?key ?tail ?environment ?result))
(horn-clause meta-bind (meta-bind ?key ?value ?environment ?result)
  (meta-occurs ?key ?value ?environment ?occurs) (meta-bind-choice ?occurs ?key ?value ?environment ?result))
(horn-clause meta-bind-cycle (meta-bind-choice yes ?key ?value ?environment failed))
(horn-clause meta-bind-fresh (meta-bind-choice no ?key ?value ?environment (unified ?result))
  (meta-store ?key ?value ?environment ?result))
(horn-clause meta-unify (meta-unify ?left ?right ?environment ?result)
  (meta-walk ?left ?environment ?a) (meta-walk ?right ?environment ?b)
  (meta-unify-walked ?a ?b ?environment ?result))
(horn-clause meta-unify-variables (meta-unify-walked (meta-variable ?a) (meta-variable ?b) ?environment ?result)
  (keys-equal ?a ?b ?same) (meta-unify-variables-choice ?same ?a ?b ?environment ?result))
(horn-clause meta-unify-same-variable (meta-unify-variables-choice yes ?a ?b ?environment (unified ?environment)))
(horn-clause meta-unify-other-variable (meta-unify-variables-choice no ?a ?b ?environment ?result)
  (meta-bind ?a (meta-variable ?b) ?environment ?result))
(horn-clause meta-unify-variable-atom (meta-unify-walked (meta-variable ?key) (meta-atom ?value) ?environment ?result)
  (meta-bind ?key (meta-atom ?value) ?environment ?result))
(horn-clause meta-unify-variable-list (meta-unify-walked (meta-variable ?key) (meta-list ?value) ?environment ?result)
  (meta-bind ?key (meta-list ?value) ?environment ?result))
(horn-clause meta-unify-atom-variable (meta-unify-walked (meta-atom ?value) (meta-variable ?key) ?environment ?result)
  (meta-bind ?key (meta-atom ?value) ?environment ?result))
(horn-clause meta-unify-list-variable (meta-unify-walked (meta-list ?value) (meta-variable ?key) ?environment ?result)
  (meta-bind ?key (meta-list ?value) ?environment ?result))
(horn-clause meta-unify-atoms (meta-unify-walked (meta-atom ?a) (meta-atom ?b) ?environment ?result)
  (bits-equal ?a ?b ?same) (meta-unify-decision ?same ?environment ?result))
(horn-clause meta-unify-yes (meta-unify-decision yes ?environment (unified ?environment)))
(horn-clause meta-unify-no (meta-unify-decision no ?environment failed))
(horn-clause meta-unify-atom-list (meta-unify-walked (meta-atom ?a) (meta-list ?b) ?environment failed))
(horn-clause meta-unify-list-atom (meta-unify-walked (meta-list ?a) (meta-atom ?b) ?environment failed))
(horn-clause meta-unify-lists (meta-unify-walked (meta-list ?a) (meta-list ?b) ?environment ?result) (meta-unify-items ?a ?b ?environment ?result))
(horn-clause meta-unify-empty (meta-unify-items end end ?environment (unified ?environment)))
(horn-clause meta-unify-short-left (meta-unify-items end (cons ?head ?tail) ?environment failed))
(horn-clause meta-unify-short-right (meta-unify-items (cons ?head ?tail) end ?environment failed))
(horn-clause meta-unify-head (meta-unify-items (cons ?a ?as) (cons ?b ?bs) ?environment ?result)
  (meta-unify ?a ?b ?environment ?head) (meta-unify-tail ?head ?as ?bs ?result))
(horn-clause meta-unify-tail-failed (meta-unify-tail failed ?as ?bs failed))
(horn-clause meta-unify-tail-next (meta-unify-tail (unified ?environment) ?as ?bs ?result) (meta-unify-items ?as ?bs ?environment ?result))

(horn-clause meta-instantiate-variable (meta-instantiate (variable ?name) ?scope (meta-variable (key ?scope ?name))))
(horn-clause meta-instantiate-atom (meta-instantiate (atom ?name) ?scope (meta-atom ?name)))
(horn-clause meta-instantiate-list (meta-instantiate (list ?items) ?scope (meta-list ?result)) (meta-instantiate-items ?items ?scope ?result))
(horn-clause meta-instantiate-empty (meta-instantiate-items end ?scope end))
(horn-clause meta-instantiate-head (meta-instantiate-items (cons ?head ?tail) ?scope (cons ?result ?rest))
  (meta-instantiate ?head ?scope ?result) (meta-instantiate-items ?tail ?scope ?rest))
(horn-clause meta-clause-here (meta-clause (cons ?clause ?tail) ?clause))
(horn-clause meta-clause-later (meta-clause (cons ?head ?tail) ?clause) (meta-clause ?tail ?clause))
# Predicate dispatch is itself an authored relation. Its repeated predicate
# variable uses the declared first-order equality law, not a host callback.
(horn-clause meta-clause-for-here
  (meta-clause-for (cons (clause ?name (list (cons (atom ?predicate) ?arguments)) ?body) ?tail)
    (meta-list (cons (meta-atom ?predicate) ?values))
    (clause ?name (list (cons (atom ?predicate) ?arguments)) ?body)))
(horn-clause meta-clause-for-later (meta-clause-for (cons ?head ?tail) ?goal ?clause)
  (meta-clause-for ?tail ?goal ?clause))
(horn-clause meta-solve-empty (meta-solve ?program end ?environment ?scope (solved ?environment ?scope end)))
(horn-clause meta-solve-goals (meta-solve ?program (cons ?goal ?goals) ?environment ?scope (solved ?final-environment ?final-scope (cons (meta-proof ?name ?goal ?premises) ?proofs)))
  (meta-clause-for ?program ?goal (clause ?name ?head ?body))
  (meta-instantiate ?head ?scope ?instance)
  (meta-unify ?goal ?instance ?environment (unified ?matched))
  (meta-instantiate-items ?body ?scope ?instances)
  (scope-next ?scope ?next-scope)
  (meta-solve ?program ?instances ?matched ?next-scope (solved ?body-environment ?body-scope ?premises))
  (meta-solve ?program ?goals ?body-environment ?body-scope (solved ?final-environment ?final-scope ?proofs)))
(horn-clause meta-project (meta-project ?value ?environment ?result)
  (meta-walk ?value ?environment ?walked) (meta-project-walked ?walked ?environment ?result))
(horn-clause meta-project-variable (meta-project-walked (meta-variable ?key) ?environment (unresolved ?key)))
(horn-clause meta-project-atom (meta-project-walked (meta-atom ?name) ?environment (atom ?name)))
(horn-clause meta-project-list (meta-project-walked (meta-list ?items) ?environment (list ?result)) (meta-project-items ?items ?environment ?result))
(horn-clause meta-project-empty (meta-project-items end ?environment end))
(horn-clause meta-project-head (meta-project-items (cons ?head ?tail) ?environment (cons ?result ?rest))
  (meta-project ?head ?environment ?result) (meta-project-items ?tail ?environment ?rest))
(horn-clause self-query (self-query ?program ?goal (answer ?result ?projected))
  (meta-instantiate ?goal end ?instance)
  (meta-solve ?program (cons ?instance end) end (one end) (solved ?environment ?scope ?proofs))
  (meta-project ?instance ?environment ?result)
  (meta-project-proofs ?proofs ?environment ?projected))

# Source-level generation is a relational operation on clause descriptions.
(horn-clause describe-clause (describe-clause (clause ?name ?head ?body) (description ?name ?head ?body)))
(horn-clause generate-clause (generate-clause (description ?name ?head ?body) (clause ?name ?head ?body)))
(horn-clause generate-program-empty (generate-program end end))
(horn-clause generate-program-next (generate-program (cons ?description ?tail) (cons ?clause ?rest))
  (generate-clause ?description ?clause) (generate-program ?tail ?rest))
(horn-clause describe-program-empty (describe-program end end))
(horn-clause describe-program-next (describe-program (cons ?clause ?tail) (cons ?description ?rest))
  (describe-clause ?clause ?description) (describe-program ?tail ?rest))

# Full, ground proof projection and independent source-defined replay.
(horn-clause meta-project-proofs-empty (meta-project-proofs end ?environment end))
(horn-clause meta-project-proofs-next (meta-project-proofs (cons (meta-proof ?name ?goal ?premises) ?tail) ?environment
  (cons (proof ?name ?projected ?children) ?rest))
  (meta-project ?goal ?environment ?projected)
  (meta-project-proofs ?premises ?environment ?children)
  (meta-project-proofs ?tail ?environment ?rest))
(horn-clause meta-replay-empty (meta-replay ?program end end ?environment ?scope (verified ?environment ?scope)))
(horn-clause meta-replay-next (meta-replay ?program (cons ?goal ?goals) (cons (proof ?name ?recorded ?premises) ?proofs)
  ?environment ?scope (verified ?final-environment ?final-scope))
  (meta-instantiate ?recorded end ?claimed)
  (meta-unify ?goal ?claimed ?environment (unified ?recorded-environment))
  (meta-clause ?program (clause ?name ?head ?body))
  (meta-instantiate ?head ?scope ?instance)
  (meta-unify ?goal ?instance ?recorded-environment (unified ?matched))
  (meta-instantiate-items ?body ?scope ?instances)
  (scope-next ?scope ?next-scope)
  (meta-replay ?program ?instances ?premises ?matched ?next-scope (verified ?body-environment ?body-scope))
  (meta-replay ?program ?goals ?proofs ?body-environment ?body-scope (verified ?final-environment ?final-scope)))
(horn-clause self-replay (self-replay ?program ?goal ?proofs (verified ?result))
  (meta-instantiate ?goal end ?instance)
  (meta-replay ?program (cons ?instance end) ?proofs end (one end) (verified ?environment ?scope))
  (meta-project ?instance ?environment ?result))
# Value-only observation avoids unfolding an engine derivation's repeated large
# input contexts. Full source proof projection remains separately requestable.
(horn-clause self-query-value (self-query-value ?program ?goal (answer ?result))
  (meta-instantiate ?goal end ?instance)
  (meta-solve ?program (cons ?instance end) end (one end) (solved ?environment ?scope ?proofs))
  (meta-project ?instance ?environment ?result))
