# Link-as-substitution for the Horn foundation.
# This source lets the generic first-order Horn resolver execute the unchanged
# lambda-link meta-semantics of fixed-point-source.lino. It defines, as Horn
# clauses, how binders are resolved, how substitution through environments
# executes, how Scott-encoded linked values are built and observed, and how the
# reduce/prove public workflows are orchestrated. The resolver knows none of
# these predicate names. Unification, clause freshening, leftmost depth-first
# resolution and answer projection remain the Horn foundation's external laws.

# Interned name codes: explicit yes/no equality, no negation as failure.
(horn-clause code-empty (code-equal end end yes))
(horn-clause code-empty-zero (code-equal end (zero ?tail) no))
(horn-clause code-empty-one (code-equal end (one ?tail) no))
(horn-clause code-zero-empty (code-equal (zero ?tail) end no))
(horn-clause code-one-empty (code-equal (one ?tail) end no))
(horn-clause code-zero-one (code-equal (zero ?a) (one ?b) no))
(horn-clause code-one-zero (code-equal (one ?a) (zero ?b) no))
(horn-clause code-zero (code-equal (zero ?a) (zero ?b) ?result) (code-equal ?a ?b ?result))
(horn-clause code-one (code-equal (one ?a) (one ?b) ?result) (code-equal ?a ?b ?result))

# Binder resolution: named lambda links become positional environment links.
(horn-clause convert-roots-end (convert-roots end end))
(horn-clause convert-roots-next (convert-roots (cons (root-source ?name ?term) ?rest) (cons (root-term ?name ?converted) ?output))
  (resolve-binders ?term end ?converted) (convert-roots ?rest ?output))
(horn-clause resolve-lambda (resolve-binders (lambda ?name ?body) ?scope (lam ?converted))
  (resolve-binders ?body (cons ?name ?scope) ?converted))
(horn-clause resolve-application (resolve-binders (application ?function ?argument) ?scope (app ?left ?right))
  (resolve-binders ?function ?scope ?left) (resolve-binders ?argument ?scope ?right))
(horn-clause resolve-variable (resolve-binders (variable ?name) ?scope (var ?index))
  (scope-index ?name ?scope ?index))
(horn-clause resolve-marker (resolve-binders (marker ?name) ?scope (marker ?name)))
(horn-clause evaluate-term (evaluate-term ?term ?output)
  (resolve-binders ?term end ?converted) (whnf ?converted end end ?output))
(horn-clause scope-index (scope-index ?name (cons ?bound ?scope) ?index)
  (code-equal ?name ?bound ?same) (scope-choice ?same ?name ?scope ?index))
(horn-clause scope-here (scope-choice yes ?name ?scope zero))
(horn-clause scope-outer (scope-choice no ?name ?scope (successor ?index)) (scope-index ?name ?scope ?index))

# Substitution by environments: a lazy Krivine machine over closure links.
(horn-clause machine-application (whnf (app ?function ?argument) ?environment ?stack ?output)
  (whnf ?function ?environment (cons (closure ?argument ?environment) ?stack) ?output))
(horn-clause machine-bind (whnf (lam ?body) ?environment (cons ?argument ?stack) ?output)
  (whnf ?body (cons ?argument ?environment) ?stack ?output))
(horn-clause machine-abstraction (whnf (lam ?body) ?environment end (abstraction ?body ?environment)))
(horn-clause machine-variable (whnf (var ?index) ?environment ?stack ?output)
  (environment-lookup ?index ?environment ?closure) (enter ?closure ?stack ?output))
(horn-clause machine-root (whnf (root ?name) ?environment ?stack ?output)
  (root-term ?name ?term) (whnf ?term end ?stack ?output))
(horn-clause machine-marker (whnf (marker ?name) ?environment ?stack (marked ?name ?stack)))
(horn-clause machine-apply (whnf (apply ?function ?argument) ?environment ?stack ?output)
  (enter ?function (cons ?argument ?stack) ?output))
(horn-clause machine-enter (enter (closure ?term ?environment) ?stack ?output)
  (whnf ?term ?environment ?stack ?output))
(horn-clause lookup-here (environment-lookup zero (cons ?closure ?environment) ?closure))
(horn-clause lookup-outer (environment-lookup (successor ?index) (cons ?closure ?environment) ?output)
  (environment-lookup ?index ?environment ?output))

# Building linked values from linked roots.
(horn-clause root-value (root-closure ?name (closure (root ?name) end)))
(horn-clause apply-value (apply-closure ?function ?argument (closure (apply ?function ?argument) end)))
(horn-clause apply-two (apply-closures-2 ?function ?first ?second ?output)
  (apply-closure ?function ?first ?partial) (apply-closure ?partial ?second ?output))
(horn-clause apply-three (apply-closures-3 ?function ?first ?second ?third ?output)
  (apply-closures-2 ?function ?first ?second ?partial) (apply-closure ?partial ?third ?output))
(horn-clause call-root-2 (call-root-2 ?name ?first ?second ?output)
  (root-closure ?name ?function) (apply-closures-2 ?function ?first ?second ?output))
(horn-clause call-root-3 (call-root-3 ?name ?first ?second ?third ?output)
  (root-closure ?name ?function) (apply-closures-3 ?function ?first ?second ?third ?output))
(horn-clause scott-cons (scott-cons ?head ?tail ?output) (call-root-2 CONS ?head ?tail ?output))

(horn-clause encode-bits-end (encode-bits end ?output) (root-closure NIL ?output))
(horn-clause encode-bits-zero (encode-bits (zero ?tail) ?output)
  (root-closure FALSE ?bit) (encode-bits ?tail ?rest) (scott-cons ?bit ?rest ?output))
(horn-clause encode-bits-one (encode-bits (one ?tail) ?output)
  (root-closure TRUE ?bit) (encode-bits ?tail ?rest) (scott-cons ?bit ?rest ?output))
(horn-clause append-bits-end (append-bits end ?right ?right))
(horn-clause append-bits-zero (append-bits (zero ?left) ?right (zero ?output)) (append-bits ?left ?right ?output))
(horn-clause append-bits-one (append-bits (one ?left) ?right (one ?output)) (append-bits ?left ?right ?output))
(horn-clause origin-bits (origin-bits (origin ?program ?name) ?output)
  (append-bits ?program (zero (zero (zero (zero (zero (zero (zero (zero ?name)))))))) ?output))

(horn-clause encode-atom (encode-node (atom ?bits) ?output)
  (encode-bits ?bits ?payload) (root-closure ATOM ?constructor) (apply-closure ?constructor ?payload ?output))
(horn-clause encode-list (encode-node (list ?items) ?output)
  (encode-nodes ?items ?children) (root-closure LIST ?constructor) (apply-closure ?constructor ?children ?output))
(horn-clause encode-nodes-end (encode-nodes end ?output) (root-closure NIL ?output))
(horn-clause encode-nodes-next (encode-nodes (cons ?node ?rest) ?output)
  (encode-node ?node ?head) (encode-nodes ?rest ?tail) (scott-cons ?head ?tail ?output))
(horn-clause encode-pattern-variable (encode-pattern (variable ?bits) ?output)
  (encode-bits ?bits ?payload) (root-closure PATTERN_VARIABLE ?constructor) (apply-closure ?constructor ?payload ?output))
(horn-clause encode-pattern-atom (encode-pattern (atom ?bits) ?output)
  (encode-bits ?bits ?payload) (root-closure PATTERN_ATOM ?constructor) (apply-closure ?constructor ?payload ?output))
(horn-clause encode-pattern-list (encode-pattern (list ?items) ?output)
  (encode-patterns ?items ?children) (root-closure PATTERN_LIST ?constructor) (apply-closure ?constructor ?children ?output))
(horn-clause encode-patterns-end (encode-patterns end ?output) (root-closure NIL ?output))
(horn-clause encode-patterns-next (encode-patterns (cons ?pattern ?rest) ?output)
  (encode-pattern ?pattern ?head) (encode-patterns ?rest ?tail) (scott-cons ?head ?tail ?output))

(horn-clause encode-rules-end (encode-rules end ?output) (root-closure NIL ?output))
(horn-clause encode-rules-next (encode-rules (cons (rule ?origin ?pattern ?replacement) ?rest) ?output)
  (origin-bits ?origin ?bits) (encode-bits ?bits ?name) (encode-pattern ?pattern ?from) (encode-pattern ?replacement ?to)
  (call-root-3 NAMED_RULE ?name ?from ?to ?head) (encode-rules ?rest ?tail) (scott-cons ?head ?tail ?output))
(horn-clause encode-facts-end (encode-facts end ?output) (root-closure NIL ?output))
(horn-clause encode-facts-next (encode-facts (cons (fact ?origin ?judgement) ?rest) ?output)
  (origin-bits ?origin ?bits) (encode-bits ?bits ?name) (encode-node ?judgement ?node)
  (call-root-2 FACT ?name ?node ?head) (encode-facts ?rest ?tail) (scott-cons ?head ?tail ?output))
(horn-clause encode-inferences-end (encode-inferences end ?output) (root-closure NIL ?output))
(horn-clause encode-inferences-next (encode-inferences (cons (inference ?origin ?premises ?conclusion) ?rest) ?output)
  (origin-bits ?origin ?bits) (encode-bits ?bits ?name) (encode-patterns ?premises ?from) (encode-pattern ?conclusion ?to)
  (call-root-3 INFERENCE ?name ?from ?to ?head) (encode-inferences ?rest ?tail) (scott-cons ?head ?tail ?output))
(horn-clause encode-rebindings-end (encode-rebindings end ?output) (root-closure NIL ?output))
(horn-clause encode-rebindings-next (encode-rebindings (cons (rebind ?from ?to) ?rest) ?output)
  (encode-bits ?from ?old) (encode-bits ?to ?new) (call-root-2 REBINDING ?old ?new ?head)
  (encode-rebindings ?rest ?tail) (scott-cons ?head ?tail ?output))
(horn-clause encode-imports-end (encode-imports end ?output) (root-closure NIL ?output))
(horn-clause encode-imports-next (encode-imports (cons (import ?program ?rebindings) ?rest) ?output)
  (encode-bits ?program ?name) (encode-rebindings ?rebindings ?chain) (call-root-2 PROGRAM_IMPORT ?name ?chain ?head)
  (encode-imports ?rest ?tail) (scott-cons ?head ?tail ?output))
(horn-clause encode-programs-end (encode-programs end ?output) (root-closure NIL ?output))
(horn-clause encode-programs-next (encode-programs (cons (program ?name ?rules ?facts ?inferences ?imports) ?rest) ?output)
  (encode-bits ?name ?label) (encode-rules ?rules ?encoded-rules) (encode-facts ?facts ?encoded-facts)
  (encode-inferences ?inferences ?encoded-inferences) (encode-imports ?imports ?encoded-imports)
  (root-closure PROGRAM ?constructor) (apply-closures-3 ?constructor ?label ?encoded-rules ?encoded-facts ?partial)
  (apply-closures-2 ?partial ?encoded-inferences ?encoded-imports ?head)
  (encode-programs ?rest ?tail) (scott-cons ?head ?tail ?output))

# Observing linked values by applying them to opaque markers.
(horn-clause observe-one (observe-1 ?value ?first ?output)
  (enter ?value (cons (closure (marker ?first) end) end) ?output))
(horn-clause observe-two (observe-2 ?value ?first ?second ?output)
  (enter ?value (cons (closure (marker ?first) end) (cons (closure (marker ?second) end) end)) ?output))
(horn-clause decode-boolean (decode-boolean ?value ?bit) (observe-2 ?value true false ?observed) (boolean-result ?observed ?bit))
(horn-clause boolean-true (boolean-result (marked true end) one))
(horn-clause boolean-false (boolean-result (marked false end) zero))
(horn-clause decode-bits (decode-bits ?value ?output) (observe-2 ?value nil cons ?observed) (bits-result ?observed ?output))
(horn-clause bits-nil (bits-result (marked nil end) end))
(horn-clause bits-cons (bits-result (marked cons (cons ?head (cons ?tail end))) (?bit ?rest))
  (decode-boolean ?head ?bit) (decode-bits ?tail ?rest))
(horn-clause decode-node (decode-node ?value ?output) (observe-2 ?value atom list ?observed) (node-result ?observed ?output))
(horn-clause node-atom (node-result (marked atom (cons ?payload end)) (atom ?bits)) (decode-bits ?payload ?bits))
(horn-clause node-list (node-result (marked list (cons ?children end)) (list ?items)) (decode-nodes ?children ?items))
(horn-clause decode-nodes (decode-nodes ?value ?output) (observe-2 ?value nil cons ?observed) (nodes-result ?observed ?output))
(horn-clause nodes-nil (nodes-result (marked nil end) end))
(horn-clause nodes-cons (nodes-result (marked cons (cons ?head (cons ?tail end))) (cons ?node ?rest))
  (decode-node ?head ?node) (decode-nodes ?tail ?rest))
(horn-clause decode-proof (decode-proof ?value (proof ?name ?judgement ?premises))
  (observe-1 ?value proof (marked proof (cons ?label (cons ?conclusion (cons ?children end)))))
  (decode-bits ?label ?name) (decode-node ?conclusion ?judgement) (decode-proofs ?children ?premises))
(horn-clause decode-proofs (decode-proofs ?value ?output) (observe-2 ?value nil cons ?observed) (proofs-result ?observed ?output))
(horn-clause proofs-nil (proofs-result (marked nil end) end))
(horn-clause proofs-cons (proofs-result (marked cons (cons ?head (cons ?tail end))) (cons ?proof ?rest))
  (decode-proof ?head ?proof) (decode-proofs ?tail ?rest))
(horn-clause decode-optional-proof (decode-optional-proof ?value ?output)
  (observe-2 ?value none some ?observed) (optional-proof-result ?observed ?output))
(horn-clause optional-proof-none (optional-proof-result (marked none end) none))
(horn-clause optional-proof-some (optional-proof-result (marked some (cons ?proof end)) (some ?decoded))
  (decode-proof ?proof ?decoded))
(horn-clause materialize (materialize-list ?value ?output ?count)
  (observe-2 ?value nil cons ?observed) (materialize-result ?observed ?output ?count))
(horn-clause materialize-nil (materialize-result (marked nil end) ?output zero) (root-closure NIL ?output))
(horn-clause materialize-cons (materialize-result (marked cons (cons ?head (cons ?tail end))) ?output (successor ?count))
  (materialize-list ?tail ?rest ?count) (scott-cons ?head ?rest ?output))

# Public workflows. Each linked root receives exactly the arguments that the
# lambda and S/K controls pass to it, and loops carry explicit unary fuel.
(horn-clause resolve-items (resolve-items ?root ?programs ?name ?output)
  (root-closure NIL ?empty) (call-root-3 ?root ?programs ?name ?empty ?option)
  (observe-2 ?option none some ?observed) (resolved-items ?observed ?output))
(horn-clause resolved-missing (resolved-items (marked none end) missing))
(horn-clause resolved-present (resolved-items (marked some (cons ?items end)) (resolved ?output))
  (materialize-list ?items ?output ?count))

(horn-clause reduce (rml-reduce ?programs ?name ?input ?fuel ?result)
  (encode-programs ?programs ?encoded) (encode-bits ?name ?label)
  (resolve-items RESOLVE_REWRITES ?encoded ?label ?rules) (reduce-with ?rules ?input ?fuel ?result))
(horn-clause reduce-missing (reduce-with missing ?input ?fuel missing-program))
(horn-clause reduce-resolved (reduce-with (resolved ?rules) ?input ?fuel ?result)
  (reduce-loop ?fuel ?rules ?input ?result))
(horn-clause reduce-exhausted (reduce-loop zero ?rules ?node bound-exceeded))
(horn-clause reduce-step (reduce-loop (successor ?fuel) ?rules ?node ?result)
  (encode-node ?node ?term) (call-root-2 REWRITE_ONCE ?rules ?term ?option)
  (observe-2 ?option none some ?observed) (reduce-choice ?observed ?fuel ?rules ?node ?result))
(horn-clause reduce-normal (reduce-choice (marked none end) ?fuel ?rules ?node (reduced ?node end)))
(horn-clause reduce-continue (reduce-choice (marked some (cons ?step end)) ?fuel ?rules ?node ?result)
  (observe-1 ?step step (marked step (cons ?term (cons ?label end))))
  (decode-node ?term ?next) (decode-bits ?label ?rule)
  (reduce-loop ?fuel ?rules ?next ?later) (reduce-trace ?rule ?later ?result))
(horn-clause reduce-trace (reduce-trace ?rule (reduced ?final ?trace) (reduced ?final (cons ?rule ?trace))))
(horn-clause reduce-trace-bound (reduce-trace ?rule bound-exceeded bound-exceeded))

(horn-clause prove (rml-prove ?programs ?name ?goal ?absent ?fuel ?result)
  (encode-programs ?programs ?encoded) (encode-bits ?name ?label)
  (resolve-items RESOLVE_REWRITES ?encoded ?label ?rules)
  (resolve-items RESOLVE_FACTS ?encoded ?label ?facts)
  (resolve-items RESOLVE_INFERENCES ?encoded ?label ?inferences)
  (prove-with ?rules ?facts ?inferences ?goal ?absent ?fuel ?result))
(horn-clause prove-missing-rules (prove-with missing ?facts ?inferences ?goal ?absent ?fuel missing-program))
(horn-clause prove-resolved (prove-with (resolved ?rules) (resolved ?facts) (resolved ?inferences) ?goal ?absent ?fuel
  (proved ?count ?derivations ?proof ?missing))
  (root-closure NIL ?empty) (call-root-3 ADD_FACTS ?facts ?empty ?rules ?declared)
  (call-root-3 ADD_FACTS ?empty ?declared ?rules ?all) (materialize-list ?all ?known ?count)
  (infer-loop ?fuel ?inferences ?known ?rules (saturated ?derivations ?final))
  (find-proof ?goal ?final ?proof) (find-proof ?absent ?final ?missing))
(horn-clause infer-exhausted (infer-loop zero ?inferences ?known ?rules bound-exceeded))
(horn-clause infer-step (infer-loop (successor ?fuel) ?inferences ?known ?rules ?result)
  (call-root-3 INFER_ONCE ?inferences ?known ?rules ?option)
  (observe-2 ?option none some ?observed) (infer-choice ?observed ?fuel ?known ?rules ?result))
(horn-clause infer-fixed-point (infer-choice (marked none end) ?fuel ?known ?rules (saturated end ?known)))
(horn-clause infer-derived (infer-choice (marked some (cons ?transition end)) ?fuel ?known ?rules ?result)
  (observe-1 ?transition transition (marked transition (cons ?derivation (cons ?inferences end))))
  (observe-1 ?derivation derivation (marked derivation (cons ?conclusion (cons ?evidence end))))
  (decode-node ?conclusion ?judgement) (decode-proof ?evidence ?proof)
  (call-root-2 KNOWN ?conclusion ?evidence ?entry) (root-closure NIL ?empty) (scott-cons ?entry ?empty ?single)
  (call-root-2 APPEND ?known ?single ?next)
  (infer-loop ?fuel ?inferences ?next ?rules ?later) (infer-trace ?judgement ?proof ?later ?result))
(horn-clause infer-trace (infer-trace ?judgement ?proof (saturated ?derivations ?final)
  (saturated (cons (derived ?judgement ?proof) ?derivations) ?final)))
(horn-clause infer-trace-bound (infer-trace ?judgement ?proof bound-exceeded bound-exceeded))
(horn-clause find-proof (find-proof ?goal ?known ?output)
  (encode-node ?goal ?judgement) (call-root-2 FIND_KNOWN_PROOF ?judgement ?known ?option)
  (decode-optional-proof ?option ?output))
